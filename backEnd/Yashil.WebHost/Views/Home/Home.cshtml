@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Yashil.Common.Core.Classes
@using YashilCommerce.Core.Classes
@using YashilCommerce.Web.Areas.ECommerce.ViewModels;
@inject ApplicationConfiguration ApplicationConfiguration

@model HomeViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
}

<link href="~/css/swiper.min.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/home.min.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/homepage_loading_skeleton.css" rel="stylesheet" asp-append-version="true" />
<script src="~/js/swiper.min.js" asp-append-version="true"></script>

@* Story Highlights *@


<section class="pt-2 pb-xxl-0 ">
    <div class="container-for-home-slider px-2">
        <div class="px-1">
            <div class=" story-highlights-container bg-white p-3 " style="border-radius: 8px;">
                <div id="border-legend-story-home-page">
                    <div class="d-flex">
                        <svg id="icon-legend-story-home-page" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-briefcase"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M22 13.478v4.522a3 3 0 0 1 -3 3h-14a3 3 0 0 1 -3 -3v-4.522l.553 .277a20.999 20.999 0 0 0 18.897 -.002l.55 -.275zm-8 -11.478a3 3 0 0 1 3 3v1h2a3 3 0 0 1 3 3v2.242l-1.447 .724a19.002 19.002 0 0 1 -16.726 .186l-.647 -.32l-1.18 -.59v-2.242a3 3 0 0 1 3 -3h2v-1a3 3 0 0 1 3 -3h4zm-2 8a1 1 0 0 0 -1 1a1 1 0 1 0 2 .01c0 -.562 -.448 -1.01 -1 -1.01zm2 -6h-4a1 1 0 0 0 -1 1v1h6v-1a1 1 0 0 0 -1 -1z" /></svg>
                        @* <svg id="icon-legend-story-home-page" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-brand-walmart"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 8.04v-5.04" /><path d="M15.5 10l4.5 -2.5" /><path d="M15.5 14l4.5 2.5" /><path d="M12 15.96v5.04" /><path d="M8.5 14l-4.5 2.5" /><path d="M8.5 10l-4.5 -2.505" /></svg> *@
                        <h3 class="fs-16 fw-bold ms-3 pe-2 ps-4 bg-white" id="legend-story-home-page">طرح اشتغال</h3>
                    </div>

                    <div class="swiper story-highlights px-4 pt-1">
                        <div class="swiper-wrapper story-wrapper">
                            <div class="swiper-slide" style="max-width: 130px">
                                <!-- Skeleton Loading Placeholder for Header Story Item -->
                                <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                    <div class="skeleton skeleton-circle"
                                         style="--c-s: 75px; --c-p: 2px"></div>
                                    <div class="skeleton skeleton-line"
                                         style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                </div>
                                <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                <!-- Header Story Item -->
                                <button id="service-selection--button" class="skeleton-content--container d-none">
                                    <div class="position-relative m-auto parent-stories-avatar-section">
                                        <div class="demo-stories-avatar position-absolute"></div>
                                        <div class="position-absolute demo-stories-avatar-background"></div>
                                        <div class="position-absolute demo-stories-avatar-image">
                                            <img data-src="/images/story/service-map.png" class="thumbnail-stories-avatar-image" />
                                        </div>
                                    </div>
                                    <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2">
                                        <p class="story-title">‌نقشه سامانه</p>
                                    </div>
                                </button>
                                <!-- Header Story Item /-->
                            </div>
                            @if (Model.IsHekmatCurrentUserCustomerClub)
                            {
                                <div class="swiper-slide" style="max-width: 130px">
                                    <!-- Skeleton Loading Placeholder for Header Story Item -->
                                    <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                        <div class="skeleton skeleton-circle"
                                             style="--c-s: 75px; --c-p: 2px"></div>
                                        <div class="skeleton skeleton-line"
                                             style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                    </div>
                                    <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                    <!-- Header Story Item -->
                                    <a href="@Url.Action("ResumeFillHelp", "Home")" class="skeleton-content--container d-none" asp-append-version="true">
                                        <div class="position-relative m-auto parent-stories-avatar-section">
                                            <div class="demo-stories-avatar position-absolute"></div>
                                            <div class="position-absolute demo-stories-avatar-background"></div>
                                            <div class="position-absolute demo-stories-avatar-image">
                                                <img data-src="/images/story/User resume.png" class="thumbnail-stories-avatar-image" />
                                            </div>
                                        </div>
                                        <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2">
                                            <p class="story-title">رزومه کاربر</p>
                                        </div>
                                    </a>
                                    <!-- Header Story Item /-->
                                </div>
                                <div class="swiper-slide" style="max-width: 130px">
                                    <!-- Skeleton Loading Placeholder for Header Story Item -->
                                    <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                        <div class="skeleton skeleton-circle"
                                             style="--c-s: 75px; --c-p: 2px"></div>
                                        <div class="skeleton skeleton-line"
                                             style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                    </div>
                                    <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                    <!-- Header Story Item -->
                                    <a href="@Url.Action("Employment", "Home")" class="skeleton-content--container d-none" asp-append-version="true">
                                        <div class="position-relative m-auto parent-stories-avatar-section">
                                            <div class="demo-stories-avatar position-absolute"></div>
                                            <div class="position-absolute demo-stories-avatar-background"></div>
                                            <div class="position-absolute demo-stories-avatar-image">
                                                <img data-src="/images/story/employment-system.png" class="thumbnail-stories-avatar-image" />
                                            </div>
                                        </div>
                                        <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2 ">
                                            <p class="story-title">سامانه اشتغال</p>
                                        </div>
                                    </a>
                                    <!-- Header Story Item /-->
                                </div>
                            }
                            @if (Model.ShowJobOfferListButton)
                            {
                                <div class="swiper-slide" style="max-width: 130px">
                                    <!-- Skeleton Loading Placeholder for Header Story Item -->
                                    <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                        <div class="skeleton skeleton-circle"
                                             style="--c-s: 75px; --c-p: 2px"></div>
                                        <div class="skeleton skeleton-line"
                                             style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                    </div>
                                    <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                    <!-- Header Story Item -->
                                    <a href="@Url.Action("JobOfferLanding", "CorporationJobCo")" class="skeleton-content--container d-none" asp-append-version="true">
                                        <div class="position-relative m-auto parent-stories-avatar-section">
                                            <div class="demo-stories-avatar position-absolute"></div>
                                            <div class="position-absolute demo-stories-avatar-background"></div>
                                            <div class="position-absolute demo-stories-avatar-image">
                                                <img data-src="/images/story/List-of-jobs.png" class="thumbnail-stories-avatar-image" />
                                            </div>
                                        </div>
                                        <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2 text">
                                            <p class="story-title">لیست مشاغل</p>
                                        </div>
                                    </a>
                                    <!-- Header Story Item /-->
                                </div>
                            }
                            <div class="swiper-slide" style="max-width: 130px">
                                <!-- Skeleton Loading Placeholder for Header Story Item -->
                                <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                    <div class="skeleton skeleton-circle"
                                         style="--c-s: 75px; --c-p: 2px"></div>
                                    <div class="skeleton skeleton-line"
                                         style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                </div>
                                <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                <!-- Header Story Item -->
                                <a href="@Url.Action("Index", "main", new { categoryGroupId = @Model.EmploymentCategoryGroupId })" class="skeleton-content--container d-none" asp-append-version="true">
                                    <div class="position-relative m-auto parent-stories-avatar-section">
                                        <div class="demo-stories-avatar position-absolute"></div>
                                        <div class="position-absolute demo-stories-avatar-background"></div>
                                        <div class="position-absolute demo-stories-avatar-image">
                                            <img data-src="/images/story/Course-leading-to-employment.png" class="thumbnail-stories-avatar-image" />
                                        </div>
                                    </div>
                                    <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2">
                                        <p class="story-title">دوره های منجر به اشتغال</p>
                                    </div>
                                </a>
                                <!-- Header Story Item /-->
                            </div>
                            <div class="swiper-slide" style="max-width: 130px">
                                <!-- Skeleton Loading Placeholder for Header Story Item -->
                                <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                    <div class="skeleton skeleton-circle"
                                         style="--c-s: 75px; --c-p: 2px"></div>
                                    <div class="skeleton skeleton-line"
                                         style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                </div>
                                <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                <!-- Header Story Item -->
                                <a href="@Url.Action("TalentExam", "Home")" class="skeleton-content--container d-none" asp-append-version="true">
                                    <div class="position-relative m-auto parent-stories-avatar-section">
                                        <div class="demo-stories-avatar position-absolute"></div>
                                        <div class="position-absolute demo-stories-avatar-background"></div>
                                        <div class="position-absolute demo-stories-avatar-image">
                                            <img data-src="/images/story/Participation-in-the-career-guidance-test.png" class="thumbnail-stories-avatar-image" />
                                        </div>
                                    </div>
                                    <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2">
                                        <p class="story-title">شرکت در آزمون هدایت شغلی</p>
                                    </div>
                                </a>
                            </div>

                            <div class="swiper-slide" style="max-width: 130px">
                                <!-- Skeleton Loading Placeholder for Header Story Item -->
                                <div class="skeleton-loading--container d-flex flex-column align-items-center">
                                    <div class="skeleton skeleton-circle"
                                         style="--c-s: 75px; --c-p: 2px"></div>
                                    <div class="skeleton skeleton-line"
                                         style="--l-h: 12px; --c-w: 120%; --lines: 2"></div>
                                </div>
                                <!-- Skeleton Loading Placeholder for Header Story Item /-->
                                <!-- Header Story Item -->
                                <a href=" @await Component.InvokeAsync("AppConfigValuePresenter", ApplicationConfigKey.YashilCommerceProductHeaderStoryItemStoryProductPromoUrl)" class="skeleton-content--container d-none" asp-append-version="true">
                                    <div class="position-relative m-auto parent-stories-avatar-section">
                                        <div class="demo-stories-avatar position-absolute"></div>
                                        <div class="position-absolute demo-stories-avatar-background"></div>
                                        <div class="position-absolute demo-stories-avatar-image">
                                            <img data-src="/images/story/Advertisement-story.png" class="thumbnail-stories-avatar-image" />
                                        </div>
                                    </div>
                                    <div class="demo-stories-name fs-12 text-muted fw-600 text-center pt-2">
                                        <p class="story-title"> @await Component.InvokeAsync("AppConfigValuePresenter", ApplicationConfigKey.YashilCommerceProductHeaderStoryItemStoryProductPromoTitle)</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="swiper-button-next header-story-next--button opacity-0"></div>
                        <div class="swiper-button-prev header-story-previous--button opacity-0"></div>
                    </div>
                </div>


            </div>
        </div>
    </div>
</section>




<!--(کروسل (اسلایدر -->
<div class="container-for-home-slider">
    <div class="d-block d-xl-flex p-2">
        <div class="col-12 col-xl-4 p-1">
            <!-- تصاویر تبلیغاتی بالا سمت راست صفحه ی اصلی -->
            @await Component.InvokeAsync("HomePageTopRightAdvertisingImage")
        </div>

        <div class="col-12 col-xl-8 p-1">
            @await Component.InvokeAsync("HomePageSlider")
        </div>
    </div>
</div>



<!-- دسته بندی ها -->
@await Component.InvokeAsync("HomePageCategory")

<!-- تصاویر تبلیغات تجاری  -->
@await Component.InvokeAsync("HomePageCommercialImage")

<!--پر فروش ترین دوره ها -->
@await Component.InvokeAsync("CourseCarouselWithImageHorizontal", new { getBestSellerCourses = true })

<!-- تصاویر مهارت آموزی -->
@await Component.InvokeAsync("HomePageLearningSkillImage")




<!-- جدید ترین دوره ها -->
@await Component.InvokeAsync("CourseCarouselWithImageHorizontal", new { getBestSellerCourses = false })

<!-- محبوب ترین مراکز آموزشی -->
@await Component.InvokeAsync("MostPopularCompanyCenters")

<!-- دسته بندی های اصلی  -->
@await Component.InvokeAsync("CategoryGroupProductsSalePlanning")


<!-- محصولات با بیشترین تخفیف -->
@await Component.InvokeAsync("FullOfDiscountsComponent")

@if (Model.IsHekmatCurrentUserCustomerClub)
{
    <!-- مودال انتخاب سامانه اشتغال یا طرح باقرالعلوم -->
    @await Html.PartialAsync("_ServiceSelectionModalPartial", Model)
}

