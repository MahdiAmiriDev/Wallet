<!-- کانفیگ سوییپر اسلایدر برای بخش استوری در بالای صفحه اصلی-->
<script type="text/javascript">

    var swiper = new Swiper(".story-highlights", {
        slidesPerView: 10,
        spaceBetween: 20,
        breakpoints: {
            280: {
                slidesPerView: 2.8
            },
            370: {
                slidesPerView: 3.1
            },
            389: {
                slidesPerView: 3.3
            },
            402: {
                slidesPerView: 3.5
            },
            450: {
                slidesPerView: 4.1
            },
            502: {
                slidesPerView: 4.5
            },
            640: {
                slidesPerView: 6,
            },
            768: {
                slidesPerView: 6,
            },
            992: {
                slidesPerView: 8,
            },
            1200: {
                slidesPerView: 10,
            },
            1400: {
                slidesPerView: 10,

            },
        },
        pagination: {
            el: ".swiper-pagination",
            clickable: true,
        },
        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },
    });

    @* showing live effect ,when onclick on each element of story highlights *@
                                                    const loader = document.querySelector('.loader');
    const demoStoriesAvatar = document.querySelector('.demo-stories-avatar');
    const swiperStoriesClick = document.querySelector('.story-wrapper');
    const headerStoriesContainerElement = document.querySelector('.story-highlights');

    function toggleStoryLoader(stroke) {
        stroke.classList.toggle('loading')
    }

    swiperStoriesClick.addEventListener('click', function (e) {
        const swiperSlide = e.target.closest(".swiper-slide");
        if (swiperSlide) {
            const avatarStroke = swiperSlide.querySelector('.demo-stories-avatar')
            toggleStoryLoader(avatarStroke);
            setTimeout(() => { toggleStoryLoader(avatarStroke) }, 2000)
        }
    });

    function storyLiveLoad() {
        loader.classList.remove('d-none');
        loader.classList.add('d-block');

        demoStoriesAvatar.classList.remove('d-block');
        demoStoriesAvatar.classList.add('d-none');
    }


    @* showing left & right button hover on story highlights  *@
    const swiperStoryHighlightElement = document.querySelector('.story-highlights');

    function toggleHeaderStorySwiperButtons(e, eventType) {
        const headerStoryNextButtonElement = e.target.querySelector(".header-story-next--button");
        const headerStoryPreviousButtonElement = e.target.querySelector(".header-story-previous--button");
        if (headerStoryNextButtonElement && headerStoryPreviousButtonElement) {
            if (eventType === 'enter') {
                headerStoryNextButtonElement.classList.remove('opacity-0');
                headerStoryPreviousButtonElement.classList.remove('opacity-0')
            } else {
                headerStoryNextButtonElement.classList.add('opacity-0');
                headerStoryPreviousButtonElement.classList.add('opacity-0')
            }
        }
    }

    headerStoriesContainerElement.addEventListener('mouseenter', function (e) {
        toggleHeaderStorySwiperButtons(e, 'enter')
    });

    headerStoriesContainerElement.addEventListener('mouseleave', function (e) {
        toggleHeaderStorySwiperButtons(e, 'leave')
    });


    // limit length text on title of story highlights
    shrinkText('.story-title', 25);
</script>