@{
    Layout = "_Layout";
}
<link href="~/css/resume.min.css" rel="stylesheet" asp-append-version="true" />

<section id="resume" class="d-none w-100 container d-flex flex-column flex-lg-row gap-3 pt-4 pt-lg-5 pt-xl-5 pt-xxl-4 mb-5 ss02">
    <div class="position-relative" style="flex: 1">
        <!-- Steps -->
        <div id="steps-wrapper" class="w-100 d-flex align-items-center position-relative" style="height: 80px; min-width: 100%; max-width: 640px; overflow-x:scroll">
            <div class="d-flex mx-auto h-100">
                <nav class="h-100" aria-label="Progress">
                    <ol role="list" id="steps-container" class="d-flex border rounded bg-light h-100 ps-0 mb-0">
                    </ol>
                </nav>
            </div>
        </div>
        <!-- /Steps -->
        <!-- Personal Information -->
        <div class="resume-step section position-relative border rounded d-none">
            <div class="border-bottom bg-light section-title gap-1 ps-3">
