                            کدملی
                        </h4>
                        <div class="national-id">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            آدرس رایانامه
                        </h4>
                        <div class="email-address">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            استان محل سکونت
                        </h4>
                        <div class="province">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            شهر محل سکونت
                        </h4>
                        <div class="city">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            شماره موبایل
                        </h4>
                        <div class="mobile-number">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            سال تولد
                        </h4>
                        <div class="birth-year">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            کدملی سرپرست
                        </h4>
                        <div class="guardian-national-id">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            شماره موبایل سرپرست
                        </h4>
                        <div class="guardian-mobile-number">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            وضعیت جسمانی
                        </h4>
                        <div class="physical-status">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div id="disability-type-container" class="col-12 col-md-6 mb-4 mb-3 d-none">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            نوع معلولیت
                        </h4>
                        <div class="disability-type">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            وضعیت تاهل
                        </h4>
                        <div class="marriage-status">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div id="children-count-container" class="col-12 col-md-6 mb-4 mb-3 d-none">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            تعداد فرزند
                        </h4>
                        <div class="children-count">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6 mb-4 mb-3">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            جنسیت
                        </h4>
                        <div class="gender">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                    <div id="military-service-container" class="col-12 col-md-6 mb-4 mb-3 d-none">
                        <h4 class="fw-bold mb-0"
                            style="font-size: 14px; color: rgb(85, 85, 85)">
                            وضعیت خدمت سربازی
                        </h4>
                        <div class="military-service">
                            <span class="profile-item"></span>
                            <div class="profile-add-item add-information-item text-decoration-none text-primary bg-transparent p-0"
                                 style="font-size: 14px; width: fit-content" data-section="personal-information">
                                مشخص کنید
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Personal Information Form -->
            <form id="personal-information-form"
                  class="flex-wrap p-4 needs-validation border border-2 border-primary hide-information"
                  style="
              row-gap: 15px;
              margin-right: 5px;
              background: rgba(13, 110, 253, 0.1);
            "
                  data-tag="information"
                  novalidate>
                <div class="col-12 col-md-6 pe-0 pe-md-2">
                    <label for="national-id"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">کدملی</label>
                    <input type="text"
                           class="form-control p-2"
                           id="national-id"
                           name="nationalId"
                           maxlength="10"
                           pattern="^([0-9]){10}$"
                           placeholder="کدملی"
                           style="font-size: 14px; direction: rtl"
                           required />
                    <div class="invalid-feedback">کدملی خود را وارد کنید.</div>
                </div>
                <div class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="email"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">آدرس رایانامه</label>
                    <input type="text"
                           class="form-control p-2"
                           id="email"
                           name="email"
                           placeholder="مثلا: test@test.com"
                           style="font-size: 14px" />
                </div>
                <div class="col-12 col-md-6 pe-0 pe-md-2">
                    <label for="province"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">استان محل سکونت</label>
                    <select class="form-select p-2"
                            id="province"
                            name="province"
                            style="font-size: 14px; color: rgb(85, 85, 85)"
                            required>
                        <option selected disabled value="">-- انتخاب کنید --</option>
                    </select>
                    <div class="invalid-feedback">
                        استان محل سکونت خود را انتخاب کنید.
                    </div>
                </div>
                <div class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="city"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">شهر محل سکونت</label>
                    <select class="form-select p-2"
                            id="city"
                            name="city"
                            style="font-size: 14px; color: rgb(85, 85, 85)"
                            required>
                        <option selected disabled value="">-- انتخاب کنید --</option>
                    </select>
                    <div class="invalid-feedback">
                        شهر محل سکونت خود را انتخاب کنید.
                    </div>
                </div>
                <div class="col-12 col-md-6 pe-0 pe-md-2">
                    <label for="mobile"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">شماره موبایل</label>
                    <input type="text"
                           class="form-control p-2"
                           id="mobile"
                           name="mobile"
                           pattern="[0]{1}[0-9]{10}"
                           maxlength="11"
                           placeholder="مثلا: 09121234567"
                           style="font-size: 14px; direction: rtl"
                           required />
                    <div class="invalid-feedback">شماره تلفن خود را وارد کنید.</div>
                </div>
                <div class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="birth-year"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">سال تولد</label>
                    <select class="form-select p-2"
                            id="birth-year"
                            name="birthYear"
                            pattern="[0-9]{4}"
                            maxlength="4"
                            placeholder="مثلا: 1372"
                            style="font-size: 14px; color: rgb(85, 85, 85)"
                            required>
                        <option selected disabled value="">-- انتخاب کنید --</option>
                    </select>
                    <div class="invalid-feedback">سال تولد خود را وارد کنید.</div>
                </div>
                <div class="col-12 col-md-6 pe-0 pe-md-2">
                    <label for="guardian-national-id"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">کدملی سرپرست</label>
                    <input type="text"
                           class="form-control p-2"
                           id="guardian-national-id"
                           name="guardianNationalId"
                           maxlength="10"
                           pattern="^([0-9]){10}$"
                           placeholder="کدملی سرپرست"
                           style="font-size: 14px; direction: rtl"
                           required />
                    <div class="invalid-feedback">کدملی سرپرست خود را وارد کنید.</div>
                </div>
                <div class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="guardian-mobile"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">شماره موبایل سرپرست</label>
                    <input type="text"
                           class="form-control p-2"
                           id="guardian-mobile"
                           name="guardianMobile"
                           pattern="[0]{1}[0-9]{10}"
                           maxlength="11"
                           placeholder="مثلا: 09121234567"
                           style="font-size: 14px; direction: rtl"
                           required />
                    <div class="invalid-feedback">شماره تلفن سرپرست خود را وارد کنید.</div>
                </div>
                <div id="physical-select-container" class="col-12 col-md-6 pe-0 pe-md-2 mb-2">
                    <label class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">وضعیت جسمانی</label>
                    <div class="position-relative">
                        <div class="form-check align-self-baseline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="normal"
                                   name="physicalStatus"
                                   value="normal"
                                   required />
                            <label class="form-check-label" for="normal">سالم</label>
                        </div>
                        <div class="form-check align-self-baseline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="disabled"
                                   name="physicalStatus"
                                   value="disabled"
                                   required />
                            <label class="form-check-label" for="disabled">دارای معلولیت</label>
                            <div class="invalid-feedback position-absolute"
                                 style="right: 0">
                                وضعیت جسمانی خود را انتخاب کنید.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="disability-type"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">نوع معلولیت</label>
                    <input type="text"
                           class="form-control p-2"
                           id="disability-type"
                           name="disabilityType"
                           placeholder="درصورت وجود معلولیت، نوع آن را بنویسید"
                           style="font-size: 14px"
                           disabled />
                    <div class="invalid-feedback">نوع معلولیت خود را بنویسید.</div>
                </div>
                <div id="marriage-select-container" class="col-12 col-md-6 pe-0 pe-md-2 mb-2">
                    <label class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">وضعیت تاهل</label>
                    <div class="position-relative">
                        <div class="form-check align-self-baseline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="bachelor"
                                   name="marriageStatus"
                                   value="bachelor"
                                   required />
                            <label class="form-check-label" for="bachelor">مجرد</label>
                        </div>
                        <div class="form-check align-self-baseline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="married"
                                   name="marriageStatus"
                                   value="married"
                                   required />
                            <label class="form-check-label" for="married">متاهل</label>
                            <div class="invalid-feedback position-absolute"
                                 style="right: 0">
                                وضعیت تاهل را انتخاب کنید.
                            </div>
                        </div>
                    </div>
                </div>
                <div id="children-count-select" class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="children-count"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">تعداد فرزند</label>
                    <select class="form-select p-2"
                            id="children-count"
                            name="childrenCount"
                            style="font-size: 14px; color: rgb(85, 85, 85)"
                            disabled>
                        <option selected disabled value="">-- انتخاب کنید --</option>
                        <option value="0">فرزند ندارم</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                    </select>
                    <div class="invalid-feedback">
                        تعداد فرزندان خود را انتخاب کنید.
                    </div>
                </div>
                <div id="gender-select-container"
                     class="col-12 col-md-6 pe-0 pe-md-2 mb-2">
                    <label class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">جنسیت</label>
                    <div class="position-relative">
                        <div class="form-check align-self-baseline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="female"
                                   name="gender"
                                   value="female"
                                   required />
                            <label class="form-check-label" for="female">زن</label>
                        </div>
                        <div class="form-check align-self-baseline">
                            <input type="radio"
                                   class="form-check-input"
                                   id="male"
                                   name="gender"
                                   value="male"
                                   required />
                            <label class="form-check-label" for="male">مرد</label>
                            <div class="invalid-feedback position-absolute"
                                 style="right: 0">
                                جنسیت خود را انتخاب کنید.
                            </div>
                        </div>
                    </div>
                </div>
                <div id="military-service-select"
                     class="col-12 col-md-6 ps-0 ps-md-2">
                    <label for="military-service"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">وضعیت خدمت سربازی</label>
                    <select class="form-select p-2"
                            id="military-service"
                            name="militaryService"
                            style="font-size: 14px; color: rgb(85, 85, 85)"
                            disabled>
                        <option selected disabled value="">-- انتخاب کنید --</option>
                    </select>
                    <div class="invalid-feedback">
                        وضعیت خدمت سربازی خود را انتخاب کنید.
                    </div>
                </div>
                <div class="d-flex justify-content-end col-12 mt-4 ms-auto">
                    <div>
                        <button class="submit-button" type="submit">
                            ذخیره
                        </button>
                        <button class="btn btn-danger cancel-form-button" type="button" data-section="personal-information">
                            انصراف
                        </button>
                    </div>
                </div>
            </form>
            <!-- /Personal Information Form -->
        </div>
        <!-- /Personal Information -->
        <!-- Education Records -->
        <div class="resume-step section position-relative border rounded d-none">
            <div class="border-bottom bg-light section-title gap-1 ps-3">
                <div>
                    <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor">
                        <use href="../images/icons/mega-menu.svg#school" />
                    </svg>
                </div>
                <h6 class="mb-0 mt-1">سوابق تحصیلی</h6>
            </div>
            <div id="education-records" class="position-relative p-3">
                <ul id="education-list" class="list-group w-100 p-4"></ul>
                <div class="no-education-found d-flex flex-wrap p-4 d-none"
                     style="color: rgb(85, 85, 85); font-size: 14px">
                    شما هنوز سوابق تحصیلی اضافه نکردید.
                </div>
            </div>
            <!-- Education Records Form -->
            <form id="education-records-form"
                  class="flex-wrap p-4 needs-validation border border-2 border-primary hide-information"
                  style="
              row-gap: 15px;
              margin-right: 5px;
              background: rgba(13, 110, 253, 0.1);
            "
                  data-tag="education"
                  novalidate>
                <div class="d-flex flex-column col-12 col-md-6 pe-0 pe-md-2">
                    <label for="major"
                           class="fw-bold form-label"
                           style="font-size: 14px; color: rgb(85, 85, 85)">رشته تحصیلی</label>
                    <select id="major" name="major" style="width:100%;" required>
                        <option></option>
                    </select>
                    <div class="invalid-feedback">رشته تحصیلی خود را وارد کنید.</div>
                </div>
                <div class="col-12 col-md-6 ps-0 ps-md-2">
