@{
    Layout = "_Layout";
}
<link href="~/css/show_resume.min.css" rel="stylesheet" />

<section id="resume" class="d-none bg-white w-100 container d-flex flex-column gap-3 p-5 mb-3 ss02">
    <div class="resume-section">
        <div class="intro-container">
            <h3 class="job-title--container">عنوان شغلی</h3>
        </div>
        <ul class="communication-container ps-0 d-flex flex-column gap-1">
            <li class="d-flex align-items-center gap-2">
                <div>
                    <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor">
                        <use href="../images/icons/general.svg#map-pin" />
                    </svg>
                </div>
                <p id="address-information" class="mb-0">آدرس</p>
            </li>
            <li class="d-flex align-items-center gap-2">
                <div>
                    <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor">
                        <use href="../images/icons/general.svg#email" />
                    </svg>
                </div>
                <p id="email-information" class="mb-0">ایمیل</p>
            </li>
            <li class="d-flex align-items-center gap-2">
                <div>
                    <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor">
                        <use href="../images/icons/general.svg#phone" />
                    </svg>
                </div>
                <p id="mobile-information" class="mb-0">شماره تلفن</p>
            </li>
        </ul>
        <div class="base-information--container">
            <h6 class="sub-section--title">اطلاعات پایه</h6>
            <ul class="communication-container ps-0 d-flex flex-column gap-1">
                <li class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center">
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/product.svg#man" />
                        </svg>
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/product.svg#woman" />
                        </svg>
                    </div>
                    <p class="mb-0">جنسیت:</p>
                    <p id="gender-information" class="mb-0">مرد</p>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <div>
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/general.svg#cake" />
                        </svg>
                    </div>
                    <p class="mb-0">سال تولد:</p>
                    <p id="birth-year--information" class="mb-0">1378</p>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <div>
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/general.svg#military-rank" />
                        </svg>
                    </div>
                    <p class="mb-0">وضعیت خدمت:</p>
                    <p id="military-service--information" class="mb-0">درحال انجام</p>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <div>
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/general.svg#heart-handshake" />
                        </svg>
                    </div>
                    <p class="mb-0">وضعیت تاهل:</p>
                    <p id="marriage-status--information" class="mb-0">مجرد</p>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <div>
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/general.svg#numbers" />
                        </svg>
                    </div>
                    <p class="mb-0">تعداد فرزندان:</p>
                    <p id="child-count--information" class="mb-0">فرزند ندارم</p>
                </li>
            </ul>
        </div>
        <div class="base-information--container">
            <h6 class="sub-section--title">اطلاعات شغلی</h6>
            <ul class="communication-container ps-0 d-flex flex-column gap-1">
                <li class="d-flex align-items-center gap-2">
                    <div class="d-flex align-items-center">
                        <svg viewBox="0 0 24 24" width="20" heigth="20" stroke="currentColor" stroke-width="2">
                            <use href="../images/icons/header.svg#user" />
                        </svg>
                    </div>
                    <p class="mb-0">وضعیت اشتغال:</p>
                    <p id="career-status--information" class="mb-0"></p>
                </li>
            </ul>
        </div>
    </div>
    <div id="education-records--section" class="resume-section">
        <div class="resume-section--title d-flex align-items-center gap-3">
            <div class="title-icon--container">
                <svg viewBox="0 0 24 24" width="26" heigth="26" stroke="#fff">
                    <use href="../images/icons/mega-menu.svg#school" />
                </svg>
            </div>
            <h3 class="mb-0">اطلاعات تحصیلی</h3>
        </div>
        <ul class="resume-section--body education-records d-flex flex-column gap-3 p-3">
            <!-- سوابق تحصیلی -->
        </ul>
    </div>
    <div id="language-records--section" class="resume-section">
        <div class="resume-section--title d-flex align-items-center gap-3">
            <div class="title-icon--container">
                <svg viewBox="0 0 24 24" width="26" heigth="26" stroke="#fff">
                    <use href="../images/icons/mega-menu.svg#language" />
                </svg>
            </div>
            <h3 class="mb-0">زبان‌های خارجی</h3>
        </div>
        <ul class="resume-section--body language-records d-flex flex-column gap-3 p-3">
            <!-- محل نمایش زبان‌ها -->
        </ul>
    </div>
    <div id="job-records--section" class="resume-section">
        <div class="resume-section--title d-flex align-items-center gap-3">
            <div class="title-icon--container">
                <svg viewBox="0 0 24 24" width="26" heigth="26" stroke="#fff">
                    <use href="../images/icons/mega-menu.svg#briefcase" />
                </svg>
            </div>
            <h3 class="mb-0">سوابق شغلی</h3>
        </div>
        <ul class="resume-section--body job-records d-flex flex-column gap-3 p-3">
            <!-- محل نمایش سوابق شغلی -->
        </ul>
    </div>
    <div id="certificate-records--section" class="resume-section">
        <div class="resume-section--title d-flex align-items-center gap-3">
            <div class="title-icon--container">
                <svg viewBox="0 0 24 24" width="26" heigth="26" stroke="#fff">
                    <use href="../images/icons/mega-menu.svg#school" />
                </svg>
            </div>
            <h3 class="mb-0">مدارک، گواهینامه‌ها و دوره‌ها</h3>
        </div>
        <ul class="resume-section--body certificate-records d-flex flex-column gap-3 p-3">
            <!-- محل نمایش مدارک -->
        </ul>
    </div>
</section>
<div class="container">
    <button type="button" id="print-resume--button" class="btn d-flex align-items-center justify-content-center gap-2 rounded mr-auto">
        <svg viewBox="0 0 24 24" width="22" heigth="22">
            <use href="../images/icons/general.svg#print" />
        </svg>
        <p class="mb-0">چاپ رزومه</p>
    </button>
</div>
<div id="loader-container">
    <span class="loader"></span>
    <p style="color: rgb(50,50,50)">درحال دریافت اطلاعات</p>
</div>


<script src="~/js/components/dist/show_resume.min.js" asp-append-version="true"></script>