@addTagHelper *, DNTCaptcha.Core
@model Yashil.Common.Core.Dtos.ChangePasswordViewModel

@{
    ViewData["Title"] = " -استعلام گواهینامه ";
    Layout = "_Layout";
}

<link href="/css/certificateSearch.css" rel="stylesheet" asp-append-version="true" />
@*full with background*@
<section class="search-certificate-section w-100 pb-3 d-flex justify-content-center align-items-center">
    <div class="w-100 pt-5">
        <p class="text-center text-white fw-600 fs-18">
            شرکت انستیتو ایزایران
        </p>
        <h1 class="text-center text-white fs-55 fw-700">گواهینامه های صادر شده</h1>
        <form id="certificate-form" method="post" class="LoginForm mt-4">
            @*main section*@
            <div class="container">
                <div class="transparent-div-search-certificate p-4 my-3 rounded-3">
                    <div class="row d-flex align-items-end justify-content-between">
                        @*first div*@
                        <div class="col-md-4 col-lg-3 pe-0 pe-md-2 ps-0 ps-lg-2 py-2 py-md-0">
                            <div class="form-group">
                                @*
                                *@
                                <label for="nationalId" class="fw-600 fs-6 mb-2">کد ملی:</label>
                                <input type="text" id="nationalId" class="certificate-form-input form-control p-2 rounded-2 border border-secondary" placeholder="کد ملی خود را وارد کنید" maxlength="10" inputmode="numeric" autocomplete="off">
                            </div>
                        </div>
                        @*sec div*@
                        <div class="col-md-8 col-lg-5 py-2 py-md-0 px-0">
                            <div class="dntCaptcha">
                                <div class="dntCaptcha">
                                    <label class="fw-600 fs-6 mb-2" for=""> عدد مشاهده شده در تصویر :</label>
                                    <div class="d-flex flex-column flex-md-row align-items-center gap-2">
                                        <div class="w-100 d-flex align-items-center justify-content-center gap-2 px-2 px-md-0">
                                            <div>
                                                <img class="dntCaptcha-img " alt="captcha" style="border-radius:0.75rem;"
                                                     id="dntCaptchaImg"
                                                     name="dntCaptchaImg" />
                                                <input id="DNTCaptchaToken" name="DNTCaptchaToken" type="hidden" />
                                                <input id="DNTCaptchaText" name="DNTCaptchaText" type="hidden" />
                                            </div>
                                            <div>
                                                <div class="svg-refresh" id="dntCaptchaRefreshButton"
                                                     name="dntCaptchaRefreshButton" onclick="doRefreshCaptcha()">
                                                </div>
                                            </div>
                                        </div>
                                        @Html.TextBoxFor(x => x.DNTCaptchaInputText, new { placeholder = "عدد را وارد کنید", autocomplete = "off", @id = "captcha", @class = "certificate-form-input form-control w-100 ss02 p-2 rounded-2 border border-secondary", @maxlength = "4", inputmode = "decimal" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        @*third div*@
                        <div class="col-md-12 col-lg-4 px-0 px-lg-2 pt-2 pt-lg-0">
                            <button type="submit" class="certificate-form-input btn btn-orange-certificate-search d-flex align-item-center justify-content-center gap-2 w-100 p-3 " style="border-radius:0.75rem;">
                                <span class="text-white fw-600 fs-15 ">جستجو</span>
                                <svg viewBox="0 0 24 24" width="20" heigth="20">
                                    <use href="../images/icons/general.svg#search" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <small id="result" class="d-none fw-bold"></small>
                        <small id="error-container" class="d-block fw-bold mt-2 text-end" style="height:20px; color:#d00000"></small>
                    </div>


                </div>
            </div>
        </form>

        <div class="container">

            <div id="listContainer" >
                <div class="row">
                    <div class=" d-flex align-items-center col-12 col-sm-6 col-md-6 col-lg-2 pt-2 pt-md-0">
                    </div>
                </div>
            </div>
        </div>


    </div>




</section>


@*print response*@
<!-- The checkRecipient Modal -->
<div class="modal fade" id="certificate-modal">
    <div class="modal-dialog modal-dialog-centered mx-auto">
        <div class="modal-content">
            <!-- Modal Header-->
            <div class="modal-header">
                <h4 class="modal-title">مشخصات گواهینامه</h4>
                <button type="button" class="btn-close m-0"
                        data-bs-dismiss="modal" data-dismiss="modal"></button>
            </div>
            <!-- Modal body -->
            <div class="modal-body p-0">
                <section class="position-relative">
                    <button onclick="jQuery.print('#print-preview')" type="button" class="certificateSearchBtn btn print-btn-in-certificate d-block  mx-auto  mt-3  fs-14 px-4  ">
                        چاپ
                        <svg viewBox="0 0 24 24" width="22" heigth="22">
                            <use href="../images/icons/general.svg#print" />
                        </svg>
                    </button>
                    <div id="certificate-container"></div>
                </section>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/js/components/authentication/captcha.min.js" asp-append-version="true"></script>
    <script src="~/js/components/authentication/forge.all.min.js" asp-append-version="true"></script>
    <script src="~/js/components/dist/certificate.min.js" asp-append-version="true"></script>
    <script src="~/js/certificateSearch.min.js" asp-append-version="true"></script>
}
