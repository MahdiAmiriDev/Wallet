@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, DNTCaptcha.Core
@model Yashil.Common.Core.Dtos.LoginViewModel
@using Yashil.Common.Core.Classes;
@inject ApplicationConfiguration _applicationConfiguration;
@{
    Layout = "_BaseLayout";
}
<style>
    span {
        color: #ff2c50;
        font-size: 12px;
    }

</style>
<div class="d-flex align-items-center justify-content-center lh-lg vh-100 ss02">
    <div class="bg-white border-login ">

        <form id="loginForm" method="post" class="LoginForm">
            <div class="d-flex align-items-center justify-content-center">
                @await Component.InvokeAsync("Logo")
            </div>
            <div class="mt-2">
                <span class="fs-18 fw-800 login-by-password-title"> ورود | ثبت نام</span>
            </div>

            <div class="mt-1 ">
                <label class="fs-12" for="username">شماره موبایل </label>
                @Html.TextBoxFor(x => x.UserName, new { autocomplete = "off", autofocus = "autofocus", inputmode = "tel", @class = "input-login input-login-page w-100 ss02" })
                <div style="height:0px">
                    @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "validationMessage fs-12 text-danger ", })
                </div>
            </div>
            <div class="mt-4 ">
                <label class="fs-12" for="password">رمز عبور</label>
                @Html.PasswordFor(x => x.Password, new { @class = "input-login input-login-page w-100 ss02" })
                <div style="height:0px">
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "validationMessage fs-12 text-danger" })
                </div>

            </div>

            <div class="mt-4">
                <div class="">
                    @Html.HiddenFor(x => x.PublicPageLoginForm)
                    @Html.HiddenFor(x => x.BackUrl)
                </div>
            </div>
            <div class="">
                <div class="dntCaptcha">
                    <div class="dntCaptcha">
                        <label class="fs-12 " for="">کد امنیتی</label>

                        <div class="d-flex align-items-center">
                            @Html.TextBoxFor(x => x.DNTCaptchaInputText, new { autocomplete = "off", @class = "input-login input-login-page w-100 ss02 me-2 px-2 text-center", @maxlength = "4", inputmode = "decimal" })

                            <div>
                                <img class="dntCaptcha-img" alt="captcha"
                                     id="dntCaptchaImg"
                                     name="dntCaptchaImg" />
                                <input id="DNTCaptchaToken" name="DNTCaptchaToken" type="hidden" />
                                <input id="DNTCaptchaText" name="DNTCaptchaText" type="hidden" />
                            </div>
                            <div>
                                <div class="svg-refresh" id="dntCaptchaRefreshButton"
                                     name="dntCaptchaRefreshButton" onclick="doRefreshCaptcha()">
                                </div>
                            </div>

                        </div>

                        <div style="height:0px">
                            @Html.ValidationMessageFor(x => x.DNTCaptchaInputText, "", new { @class = "validationMessage fs-12 text-danger" })
                        </div>
                    </div>
                </div>
                <div class="row mt-1">
                    <div class="form-group mt-5">
                        <button type="submit" id="loginButton" class="d-flex alig-items-center justify-content-center w-100 p-1 login-with-pass-btn gap-2">
                            <span class="spinner-border spinner-border-sm text-warning d-none my-auto" role="status" aria-hidden="true"></span>
                            ورود
                        </button>
                    </div>
                </div>

                @if (!_applicationConfiguration.SmsBased)
                {
                    <div class="mt-2">
                        <a href="/user/register">
                            <label class="d-flex align-items-center fs-12 fw-500 text-info cursor-pointer" for="username">
                                ثبت نام
                                <div class="svg-left-arrow-blue"></div>
                            </label>
                        </a>
                    </div>
                }

                @if (_applicationConfiguration.SmsBased)
                {
                    <div class="mt-2">
                        <a onclick="loginByVerifyCode(event)">
                            <label class="d-flex align-items-center customLable cursor-pointer text-orange-login-password fw-500 gap-1" for="username">
                                <span class="text-orange-login-password">ورود با رمز عبور یکبار مصرف</span>
                                <div>
                                    <svg viewBox="0 0 16 16" width="22" height="22" stroke="currentColor" stroke-width="2">
                                        <use href="../images/icons/general.svg#chevron-left" />
                                    </svg>
                                </div>
                            </label>
                        </a>
                    </div>
                }


                <div class="row my-3">
                    <div class="w-100">
                        <span class="loginError">
                        </span>
                    </div>
                </div>
            </div>
            @*            <div class="row my-3">
            <div class="" style="height:46px">
            <div class="alert alert-warning hide fade text-right w-100" id="validationErrorMessage" role="alert">
            <strong>خطا!</strong> لطفا ورودی ها را چک کنید.
            </div>
            </div>
            </div>*@



        </form>

    </div>

    <form style="display:none" method="POST" id="loginVerifyCodeForm" action="/user/login">
        <input type="hidden" name="_back"
               value="@Model.ReturnUrl" />
        <button style="display:none">برو</button>
    </form>
    <form method="POST" action="" id="frmLogin" style="display:none">
        <input type="hidden" name="token" id="token" value="" />
        <input type="hidden" name="serviceId" value="edus.ir" />
        <input type="hidden" name="_back" value="@Model.BackUrl" />
        <input type="hidden" name="formId" value="emis-v3-mob-in-isiran-subscribe" />
        <button style="display:none">برو</button>
    </form>
</div>



@section scripts
{
    <script type="text/javascript">
        const loginFormElement = document.getElementById('loginForm');
        const submitButton = loginFormElement.querySelector('#loginButton');
        const spinnerElement = loginFormElement.querySelector('.spinner-border');

        var loginByPasswordValue = document.querySelector('#Password');

        var useEngilishCharacterMessage = 'لطفا از اعداد و حروف انگلیسی استفاده نمایید';




        // آپدیت شدن مقدار placeholder در فیلد رمز عبور
        function updatePlaceholderLoginByPasswordValue(value) {
            if (value.trim() === '') {
                loginByPasswordValue.placeholder = '';
            } else {
                loginByPasswordValue.placeholder = useEngilishCharacterMessage;
            }
        }


        loginByPasswordValue.addEventListener('input', function (event) {
            const inputValue = this.value;

            // آپدیت کردن مقدار placeholder بعد از تغییر ورودی رمز عبور
            updatePlaceholderLoginByPasswordValue(inputValue);

            // چک می کند ورودی به زبان انگلیسی باشد
            if (!isEnglish(inputValue)) {
                // اگر کاراکتر ها غیر انگلیسی باشد چیزی نمایش نمی دهد
                this.value = inputValue.replace(/[^a-zA-Z\s]/g, '');

            }
        });



        //چک کردن انگلیسی بودن کیبورد
        function isEnglish(text) {
            return /^[a-zA-Z0-9\s#$%^&*()@@_+=!~`{}\[\]\{\}\(\)\|\;\:\'\"\,\.\?\/\-\+\=\!\s]+$/.test(text);
        }



        loginFormElement.addEventListener('submit', function (e) {
            e.preventDefault();
            spinnerElement.classList.remove('d-none');
            submitButton.setAttribute('disabled', true);
            if ($("#loginForm").valid()) {
                fetch('/api/User/GetKeyForEncryption',
                    {
                        method: 'GET'
                    }).then(response => response.json()).then(rsaKey => {
                        loginByPassword(rsaKey, e);
                    }).catch(data => {
                        doRefreshCaptcha();
                        clearUserInputs();
                        spinnerElement.classList.add('d-none');
                        submitButton.removeAttribute('disabled');
                        bootbox.alert('<b>خطا !</b>مشکل در ورود به سایت');

                    });
            } else {
                spinnerElement.classList.add('d-none');
                submitButton.removeAttribute('disabled');
                bootbox.alert('<b>خطا !</b> لطفا ورودی ها را چک کنید ');
            }
        })
        function loginByPassword(rsaKey, e) {
            var userName = $("#UserName").val();
            var password = $("#Password").val();
            userName = userName.toEnglishDigit();
            password = password.toEnglishDigit();
            $("#UserName").val(userName);
            $("#Password").val(password);
            var jsonObject = Object.fromEntries(new FormData(e.target));
            jsonObject.Password = encryptRsa(jsonObject.Password, rsaKey);
            jsonObject.PublicPageLoginForm = Boolean(($("#PublicPageLoginForm").val().toLowerCase() === 'true'));
            jsonObject.Key = rsaKey.entryKey;

            var formData = new FormData();
            for (let key in jsonObject) {
                formData.append(key, jsonObject[key]);
            }

            fetch('/api/authentication/authenticate',
                {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    clearUserInputs();
                    doRefreshCaptcha();
                    if (data.succeeded) {
                        if (data.returnUrl !== null && data.returnUrl !== undefined) {
                            $('#frmLogin').attr('action', data.returnUrl);
                            $("#token").val(data.externalToken);
                            $("#_back").val(data.backUrl);
                            $('#frmLogin').submit();
                        } else {
                            window.location = '/';
                        }
                    } else {
                        spinnerElement.classList.add('d-none');
                        submitButton.removeAttribute('disabled');
                        bootbox.alert('نام کاربری یا رمز عبور اشتباه است.');
                    }
                })
                .catch(data => {
                    doRefreshCaptcha();
                    clearUserInputs();
                    spinnerElement.classList.add('d-none');
                    submitButton.removeAttribute('disabled');
                    bootbox.alert('نام کاربری یا رمز عبور اشتباه است.');

                });
        }


        function loginByVerifyCode(e) {
            $('#loginVerifyCodeForm').submit();
        }

        function clearUserInputs() {
            $('#DNTCaptchaInputText').val('');
            $('#Password').val('');
        }

    </script>
    <script src="~/js/components/authentication/captcha.js" asp-append-version="true"></script>
    <script src="~/js/components/authentication/forge.all.min.js" asp-append-version="true"></script>
}
