@*@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, DNTCaptcha.Core*@
@*@model Yashil.Common.Core.Dtos.LoginViewModel*@
@{
    Layout = "_BaseLayout";
}
 

<div class="content-wrap">
    <div class="content-page-fullwidth-wrap clearfix pd-top-45">
        <div class="container-fluid">
            <div class="container">
                <div class="row">
                    <div class="col-md-12 col-lg-12 col-sm-12 col-xs-12">
                        <div class="col-md-4 col-lg-4 hidden-sm hidden-xs"></div>
                        <form id="loginForm"  method="post" class="col-lg-4 col-md-4 col-sm-12 col-xs-12 LoginForm" style="margin-top:100px;">
                            <div class="row">
                               <a href="/user/LoginRegister"><img src="~/images/arrow 9.png" alt="arrow" style="display:inline-block;height: 15px;margin-top: 53px;margin-right: 28px;" /></a> 
                                <img src="~/images/logo/login_logo.png" alt="Logo ISIRAN Institute" style="height: 90px;display: inline-block;margin-right: 75px;margin-top: 10px;display:inline-block" />

                            </div>
                            <div class="row" style="margin-top: 30px;">
                                <span class="loginregister fullwidth"> درخواست بازیابی رمز عبور</span>
                            </div>
                            <div class="row" style="margin-top:10px;">
                                <div class="form-group fullwidth">
                                    <label class="customLable" for="username">لطفا پست الکترونیک یا شماره موبایل خود را وارد نمائید </label>
                                   
                                    <input type="text"  />
                                    <div class="customLable">
                                        
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row" style="margin-top:20px;">
                                <div class="form-group fullwidth">
                                    <div style="width:100%">
                                        <button type="submit" class="loginButton">
                                            <i id="spinner" style="display:none" class="fas fa-spinner fa-spin"></i> ادامه
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row" style="margin-top:5px;margin-bottom:20px;">
                                <div class="form-group fullwidth">
                                    <div style="width:100%">
                                        <span class="loginError">
                                            
                                        </span>
                                    </div>
                                </div>
                            </div>

                        </form>
                        <div class="col-md-4 col-lg-4 hidden-sm hidden-xs"></div>
                    </div>

                </div>
            </div>

        </div>
    </div> 

</div>




