@model Yashil.Common.Core.Dtos.ChangePasswordViewModel
@addTagHelper *, DNTCaptcha.Core
@{
    ViewData["Title"] = "تغییر پسورد";
    Layout = "_BaseLayout";
}

<div class="d-flex align-items-center justify-content-center lh-lg vh-100 ss02">
    <div class="bg-white border-login ss02  ">
        <form id="ChangePasswordForm" method="post" class="LoginForm">
            <div class="d-flex align-items-center justify-content-center">
                @await Component.InvokeAsync("Logo")
            </div>
            <div class="mt-3">
                <span class="fs-18 fw-800"> تغییر رمز عبور</span>
            </div>

            <div class="">
                <div class="form-group">
                    @Html.LabelFor(x => x.OldPassword)
                    <div>
                        @Html.PasswordFor(x => x.OldPassword, new { autofocus = "autofocus", @class = "input-login" })
                    </div>
                    <div style="height:25px">
                        @Html.ValidationMessageFor(x => x.OldPassword, "", new { @class = "validationMessage text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    @Html.LabelFor(x => x.NewPassword)
                    <div>
                        @Html.PasswordFor(x => x.NewPassword, new { id = "newPasswordInputText", @class = "input-login" })
                    </div>
                    <div style="height:25px">
                        @Html.ValidationMessageFor(x => x.NewPassword, "", new { @class = "validationMessage text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    @Html.LabelFor(x => x.NewPasswordConfirm)
                    <div>
                        @Html.PasswordFor(x => x.NewPasswordConfirm, new { @class = "input-login" })
                    </div>
                    <div style="height:25px">
                        @Html.ValidationMessageFor(x => x.NewPasswordConfirm, "", new { @class = "validationMessage text-danger" })
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="dntCaptcha">
                    <div class="dntCaptcha">
                        <label class="fs-12 " for="">کد امنیتی</label>

                        <div class="d-flex align-items-center">
                            @Html.TextBoxFor(x => x.DNTCaptchaInputText, new { autocomplete = "off", @class = "input-login input-login-page w-100 ss02 me-2 px-2 text-center ", @maxlength = "4", inputmode = "decimal" })

                            <div>
                                <img class="dntCaptcha-img" alt="captcha"
                                     id="dntCaptchaImg"
                                     name="dntCaptchaImg" />
                                <input id="DNTCaptchaToken" name="DNTCaptchaToken" type="hidden" />
                                <input id="DNTCaptchaText" name="DNTCaptchaText" type="hidden" />
                            </div>
                            <div>
                                <div class="svg-refresh" id="dntCaptchaRefreshButton"
                                     name="dntCaptchaRefreshButton" onclick="doRefreshCaptcha()">
                                </div>
                            </div>

                        </div>

                        <div style="height:25px">
                            @Html.ValidationMessageFor(x => x.DNTCaptchaInputText, "", new { @class = "validationMessage fs-12 text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group ">
                    <div>
                        <button type="submit" class="loginButton mt-3">
                            <span class="spinner-border spinner-border-sm text-warning d-none my-auto" role="status" aria-hidden="true"></span>
                            تغییر رمز عبور
                        </button>
                    </div>
                </div>
            </div>


        </form>
    </div>
</div>



@section Scripts {
    <script>
        var oldPasswordValue = document.querySelector('#OldPassword');
        var newPasswordValue = document.querySelector('#newPasswordInputText');
        var newPasswordConfirmValue = document.querySelector('#NewPasswordConfirm');
        var useEngilishCharacterMessage = 'لطفا از اعداد و حروف انگلیسی استفاده نمایید';

        oldPasswordValue.addEventListener('input', function (event) {
            const inputValue = this.value;

            // آپدیت کردن مقدار placeholder بعد از تغییر ورودی رمز عبور
            updatePlaceholderValue(inputValue, 'oldPassword');

            // چک می کند ورودی به زبان انگلیسی باشد
            if (!isEnglish(inputValue)) {
                // اگر کاراکتر ها غیر انگلیسی باشد چیزی نمایش نمی دهد
                this.value = inputValue.replace(/[^a-zA-Z\s]/g, '');

            }
        });

        newPasswordValue.addEventListener('input', function (event) {
            const inputValue = this.value;

            // آپدیت کردن مقدار placeholder بعد از تغییر ورودی رمز عبور
            updatePlaceholderValue(inputValue, 'newPassword');

            // چک می کند ورودی به زبان انگلیسی باشد
            if (!isEnglish(inputValue)) {
                // اگر کاراکتر ها غیر انگلیسی باشد چیزی نمایش نمی دهد
                this.value = inputValue.replace(/[^a-zA-Z\s]/g, '');

            }
        });

        newPasswordConfirmValue.addEventListener('input', function (event) {
            const inputValue = this.value;

            // آپدیت کردن مقدار placeholder بعد از تغییر ورودی رمز عبور
            updatePlaceholderValue(inputValue, 'newPasswordConfirm');

            // چک می کند ورودی به زبان انگلیسی باشد
            if (!isEnglish(inputValue)) {
                // اگر کاراکتر ها غیر انگلیسی باشد چیزی نمایش نمی دهد
                this.value = inputValue.replace(/[^a-zA-Z\s]/g, '');

            }
        });

        // آپدیت شدن مقدار placeholder در فیلد رمز عبور
        function updatePlaceholderValue(value, inputName) {
            switch (inputName) {
                case 'oldPassword':
                    if (value.trim() === '') {
                        oldPasswordValue.placeholder = '';
                    } else {
                        oldPasswordValue.placeholder = useEngilishCharacterMessage;
                    }
                    break;

                case 'newPassword':
                    if (value.trim() === '') {
                        newPasswordValue.placeholder = '';
                    } else {
                        newPasswordValue.placeholder = useEngilishCharacterMessage;
                    }
                    break;

                case 'newPasswordConfirm':
                    if (value.trim() === '') {
                        newPasswordConfirmValue.placeholder = '';
                    } else {
                        newPasswordConfirmValue.placeholder = useEngilishCharacterMessage;
                    }
                    break;
            }
        }

        //چک کردن انگلیسی بودن کیبورد
        function isEnglish(text) {
            return /^[a-zA-Z0-9\s#$%^&*()@@_+=!~`{}\[\]\{\}\(\)\|\;\:\'\"\,\.\?\/\-\+\=\!\s]+$/.test(text);
        }



        const submitButton = document.querySelector('.loginButton');
        const spinnerElement = submitButton.querySelector('.spinner-border');
        hideErrorMessage($("#validationErrorMessage"));
        hideErrorMessage($("#validationSuccessMessage"));

        $("#ChangePasswordForm").submit(function (e) {
            e.preventDefault();
            hideErrorMessage($("#validationErrorMessage"));
            hideErrorMessage($("#validationSuccessMessage"));
            spinnerElement.classList.remove('d-none');
            submitButton.setAttribute('disabled', true);

            if ($("#ChangePasswordForm").valid()) {
                fetch('/api/User/GetKeyForEncryption',
                    {
                        method: 'GET'
                    }).then(response => response.json()).then(rsaKey => {
                        changePassword(rsaKey, e);
                    }).catch(data => {
                        doRefreshCaptcha();
                        clearUserInputs();
                        spinnerElement.classList.add('d-none');
                        submitButton.removeAttribute('disabled');
                        bootbox.alert('مشکل در تغییر پسورد');
                    });
            } else {
                spinnerElement.classList.add('d-none');
                submitButton.removeAttribute('disabled');
                bootbox.alert('مشکل در تغییر پسوردورودی ها را چک نمایید');
            }


        });
        function changePassword(rsaKey, e) {
            var jsonObject = Object.fromEntries(new FormData(e.target));
            jsonObject.OldPassword = encryptRsa(jsonObject.OldPassword, rsaKey);
            jsonObject.NewPassword = encryptRsa(jsonObject.NewPassword, rsaKey);
            jsonObject.NewPasswordConfirm = encryptRsa(jsonObject.NewPasswordConfirm, rsaKey);
            jsonObject.Key = rsaKey.entryKey;
            let formData = new FormData();
            for (let key in jsonObject) {
                formData.append(key, jsonObject[key]);
            }

            fetch('/api/authentication/changePassword',
                {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    clearUserInputs();
                    doRefreshCaptcha();
                    spinnerElement.classList.add('d-none');
                    submitButton.removeAttribute('disabled');
                    if (data.succeeded) {

                        hideErrorMessage($("#validationErrorMessage"));
                        bootbox.alert('پسورد با موفقیت تغییر پیدا کرد!');
                        window.location = '/';
                    } else if (data.message == null) {
                        bootbox.alert('مشکل در تغییر پسورد');

                    } else {
                        bootbox.alert(data.message);
                    }
                })
                .catch(data => {
                    doRefreshCaptcha();
                    clearUserInputs();
                    spinnerElement.classList.add('d-none');
                    submitButton.removeAttribute('disabled');
                    bootbox.alert('مشکل در تغییر پسورد');

                });
        }

        function clearUserInputs() {
            $('#DNTCaptchaInputText').val('');
            $('#OldPassword').val('');
            $('#newPasswordInputText').val('');
            $('#NewPasswordConfirm').val('');
        }

    </script>
    <script src="~/js/components/authentication/captcha.js" asp-append-version="true"></script>
    <script src="~/js/components/authentication/forge.all.min.js" asp-append-version="true"></script>
}

