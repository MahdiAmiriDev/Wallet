@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model YashilUserManagement.Web.Areas.UserMngAdminApi.ViewModels.MessageSimpleViewModel
@{
    Layout = "_BaseLayout";
    int expireTimeValue;
    if (Model != null)
    {
        expireTimeValue = Model.ExpireTimeValue;
    }
    else
    {
        return;
    }
}

<svg xmlns="http://www.w3.org/2000/svg" class="d-none">
    <symbol id="check-circle-fill" viewBox="0 0 16 16">
        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
    </symbol>
    <symbol id="info-fill" viewBox="0 0 16 16">
        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
    </symbol>
    <symbol id="exclamation-triangle-fill" viewBox="0 0 16 16">
        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
    </symbol>
</svg>
<div class="alert alert-success d-flex justify-content-center align-items-center align-self-center fs-18 fw-700 success-div-hekmat-card-number d-none" role="alert">
    <svg class="bi flex-shrink-0 me-2" role="img" aria-label="Success:" style="width: 25px;height: 25px;">
        <use xlink:href="#check-circle-fill" />
    </svg>
    <div class="success-alert-hekmat-card-number ">
        @* alert text (do not delete) *@
    </div>
</div>

<div class="d-flex align-items-center justify-content-center lh-lg vh-100 ss02 sms-verification-login-form d-block">
    <div class="bg-white border-login ss02 ">

        <form class="LoginForm" onsubmit="confirmVerifyCode(event)">
            <div class="d-flex align-items-center justify-content-center position-relative">
                <div class="position-absolute" onclick="goToLoginPage('/user/login')" style="cursor: pointer; right: 0">
                    <svg viewBox="0 0 20 20" width="30" height="30" stroke="#2c3e50">
                        <use href="../images/icons/general.svg#arrow-narrow-right" />
                    </svg>
                </div>
                @await Component.InvokeAsync("Logo")
            </div>
            <div class="mt-3">
                <span class="fs-18 fw-700 confirm-title">کد تایید را وارد نمایید</span>
            </div>
            <div class="form-group">
                <label class="customLable ss02"> کد تایید برای شماره موبایل @Model.SendTo ارسال گردید </label>
                <div>
                    <input autofocus class="input-login input-login-page text-center w-100 ss02 login-code-letter-spacing input-sms-verification-form" type="text" dir="rtl" id="verifyCode" name="verifyCode" maxlength="5" autocomplete="off" inputmode="tel" />
                    <div class="customLable">
                        <span class="validationMessage">@Model.Result</span>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="form-group text-center">
                    <a onclick="goToLoginPage('/user/loginByPassword')">
                        <label class="d-flex align-items-center text-orange-confirm-sms fs-12 float-start cursor-pointer ">
                            <span class="text-orange-confirm-sms fw-600">ورود با رمز عبور</span>
                            <div>
                                <svg viewBox="0 0 16 16" width="22" height="22" stroke="currentColor" stroke-width="2">
                                    <use href="../images/icons/general.svg#chevron-left" />
                                </svg>
                            </div>
                        </label>

                    </a>


                </div>
            </div>
            <div class="row mt-2">
                <div class="form-group text-center">
                    <label id="counterdown" class="m-auto fs-12">
                        <span class="ss02" id="timer"></span> مانده تا دریافت مجدد کد
                    </label>


                </div>
            </div>
            <div class="row mt-3">
                <div class="form-group">
                    <div class="w-100">
                        <button type="submit" class="d-flex alig-items-center justify-content-center w-100 p-1 continue-with-sms-btn gap-2" onclick="confirmVerifyCode(event)">
                            <span class="spinner-border spinner-border-sm text-warning d-none my-auto" role="status" aria-hidden="true"></span>
                            ادامه
                        </button>
                    </div>
                </div>
            </div>

            <div class="row mt-1 mb-3">
                <div class="form-group">
                    <div class="w-100">
                        <span class="loginError">

                        </span>
                    </div>
                </div>
            </div>


        </form>

    </div>
    <form method="POST" action="" id="frmConfirm" style="display:none">
        <input type="hidden" name="serviceId" value="edus.ir" />
        <input type="hidden" name="formId" value="emis-v3-mob-in-isiran-subscribe" />
        <input type="hidden" name="_back" value="@Model.ReturnUrl" />
        <input type="hidden" name="token" id="token" value="" />
        <button style="display:none">برو</button>
    </form>
    <form method="POST" id="loginForm" action="/user/login" style="display:none">
        <input type="hidden" name="_back"
               value="@Model.ReturnUrl" />
        <button style="display:none">برو</button>
    </form>
</div>




<div class="d-flex align-items-center justify-content-center lh-lg vh-100 ss02 card-number-login-form d-none">
    <div class="bg-white border-login ss02 ">

        <form class="LoginForm" onsubmit="confirmVerifyCode(event)">
            <div class="d-flex align-items-center justify-content-center position-relative">

                @await Component.InvokeAsync("Logo")
            </div>
            <div class="mt-3">
                <span class="fs-18 fw-700 confirm-title">در صورت داشتن حکمت کارت ، آن را وارد نمایید</span>
            </div>
            <div class="form-group">
                <label class="customLable ss02"> کاربر گرامی با توجه به اینکه کارت حکمت را وارد نکردید از تخفیف های حکمت نمی توانید استفاده کنید: </label>
                <div>
                    <input class="input-login input-login-page w-100 ss02 card-number-letter-spacing input-card-number-form" type="text" dir="ltr" id="card-number" name="card-number" maxlength="16" autocomplete="off" inputmode="tel" />
                    <div class="customLable">
                        <span class="validationMessage">@Model.Result</span>
                    </div>
                </div>
            </div>



            <div class="row mt-3">
                <div class="form-group">
                    <div class="w-100 d-block d-md-flex justify-content-between align-items-center gap-3">
                        <button type="submit" id="submit-card-number-btn" class="d-flex alig-items-center justify-content-center w-100 p-1 continue-with-sms-btn gap-2 my-2" onclick="submitHekmatCardNumberAfterLogin(event)">
                            <span class="spinner-border spinner-border-sm text-warning d-none my-auto" role="status" aria-hidden="true"></span>
                            ثبت
                        </button>

                        <button type="submit" class="d-flex alig-items-center justify-content-center w-100 p-1 continue-with-sms-btn-outline gap-2 my-2" onclick="continueWithoutHekmat(event)">
                            <span class="spinner-border spinner-border-sm text-warning d-none my-auto" role="status" aria-hidden="true"></span>
                            حکمت کارت ندارم
                        </button>

                    </div>
                </div>
            </div>

            <div class="row mt-1 mb-3">
                <div class="form-group">
                    <div class="w-100">
                        <span class="loginError">

                        </span>
                    </div>
                </div>
            </div>


        </form>

    </div>
    <form method="POST" action="" id="frmConfirm" style="display:none">
        <input type="hidden" name="serviceId" value="edus.ir" />
        <input type="hidden" name="formId" value="emis-v3-mob-in-isiran-subscribe" />
        <input type="hidden" name="_back" value="@Model.ReturnUrl" />
        <input type="hidden" name="token" id="token" value="" />
        <button style="display:none">برو</button>
    </form>
    <form method="POST" id="loginForm" action="/user/login" style="display:none">
        <input type="hidden" name="_back"
               value="@Model.ReturnUrl" />
        <button style="display:none">برو</button>
    </form>
</div>





@section scripts
{

    <script>

        const loginFormElement = document.querySelector('.LoginForm');
        const submitButton = loginFormElement.querySelector('.continue-with-sms-btn');
        const spinnerElement = loginFormElement.querySelector('.spinner-border');


        const cardNumberLoginForm = document.querySelector('.card-number-login-form');
        const smsVerificationLoginForm = document.querySelector('.sms-verification-login-form');

        const smsVerificationInputForm = document.querySelector('.input-sms-verification-form');
        const cardNumberInputForm = document.querySelector('.input-card-number-form');

        const cardNumberAlerForm = document.querySelector('.success-alert-hekmat-card-number');
        const cardNumberDivAlerForm = document.querySelector('.success-div-hekmat-card-number');


        setTimeInterval(@expireTimeValue);

        // متد مربوط به مقدار تاریخ انقضا برای وری فای شماره موبایل کاربر
        function setTimeInterval(expireTimeValue) {
            $('#counterdown').html(' <label id="counterdown" class="" for="username" style="margin:auto;font-size:12px;"><span id="timer"></span> مانده تا دریافت مجدد کد </label>');

            var minute = 0;
            var sec = 0;
            if (expireTimeValue >= 60) {
                minute = parseInt(expireTimeValue / 60);
                sec = expireTimeValue % 60;
            }
            else {
                sec = expireTimeValue;
            }

            var interval = setInterval(function () {

                if (sec > 0) {
                    sec = sec - 1;
                }
                if (sec == 0 && minute > 0) {
                    minute = minute - 1;
                    sec = 59;
                }
                if (sec == 0 && minute == 0) {
                    $('#counterdown').html('');
                    $('#counterdown').html('<a style="font-size:14px;color: #0fabc6;font-size: 1rem;font-weight: 700;cursor:pointer;" onclick="sendVerifyCode()">دریافت مجدد کد تایید..</a>')
                    clearInterval(interval);
                }

                $('#timer').html(minute + ":" + sec);

            }, 1000);

        }




        // بعد از ورود موفق در صورت نداشتن حکمت کارت این متد اجرا میشود
        function continueWithoutHekmat(e) {
            e.preventDefault(     );
            e.stopPropagation();
            $('#frmConfirm').submit();
        }



        // متد مربوط به وری فای کد تایید 5 رقمی
        function confirmVerifyCode(e) {
            e.preventDefault();
            e.stopPropagation();
            spinnerElement.classList.remove('d-none');
            submitButton.setAttribute('disabled', true);
            var verifyCode = $("#verifyCode").val();
            verifyCode = verifyCode.toEnglishDigit();
            if (verifyCode.length != 5) {
                bootbox.alert('کد تایید 5 رقمی میباشد');
                spinnerElement.classList.add('d-none');
                submitButton.removeAttribute('disabled');
                return;
            }
            else {
                //آدرس کامل url را میگیرد
                var urlParams = new URLSearchParams(window.location.search);
                //یکی از کلید های شی urlParams
                var returnUrl = urlParams.get('returnUrl');
                //شماره موبایل کاربر
                var mobileNumber = '@Model.SendTo';

                // بعد از ارسال کد 5 رقمی به کاربر این 3 پارامتر ارسال میشود
                var dataParams = { verifyCode: verifyCode, mobileNumber: mobileNumber, backUrl: '@Model.ReturnUrl' };


                var apiUrl = '/api/user/AuthenticateByCodeAsync';

                if (returnUrl) {
                    apiUrl += "?returnUrl=" + returnUrl;
                }
                fetch(apiUrl,
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json; charset=utf-8'
                        },
                        body: JSON.stringify(dataParams)
                    })
                    .then(response => response.json())
                    .then(data => {
                        //اگر کاربر کد 5 رقمی درست وارد کند
                        if (data.isSuccess === true) {
                            //اگر آدرس url مقدار داشته باشد
                            if (data.returnUrl !== null) {
                                //آدرس  url را به اکشن اضافه می کند
                                $('#frmConfirm').attr('action', data.returnUrl);
                                // توکن امنیتی
                                $("#token").val(data.token);
                                //  در صورت ورود موفق به کدام صفحه برود
                                $("#_back").val(data.backUrl);

                                //آدرس url  را در متغیر میریزد
                                var signupRedirect = data.returnUrl;

                                // چک می کند اگر کاربر در حالت ثبت نام باشد  ، فرم ثبت میشود و حکمتی بودن کاربر چک نمی شود
                                if (signupRedirect != "/" && signupRedirect != "/ShoppingCartItem") {
                                    $('#frmConfirm').submit();
                                }


                                //اگر کاربر در حالت ورود باشد
                                else {
                                    //بررسی می کند که آیا باشگاه مشتریان کاربر جاری حکمتی می باشد یا خیر
                                    var hekmatStatusUrl = '/api/additionalUserProp/CheckIsCurrentUserHekmatCustomerClub';
                                    fetch(hekmatStatusUrl,
                                        {
                                            method: 'GET',
                                            headers: {
                                                'Content-Type': 'application/json; charset=utf-8'
                                            },
                                        })
                                        .then(response => response.json())
                                        .then(isCurrentUserHekmatMember => {

                                            // اگر کاربر  حکمتی باشد فرم ثبت میشود
                                            if (isCurrentUserHekmatMember) {
                                                $('#frmConfirm').submit();

                                            }
                                            //اگر کاربر حکمتی نباشد بعد از تایید کد 5 رقمی به فرم ثبت کارت حکمت وارد میشود
                                            else {
                                                //فرم ورود کد 5 رقمی پنهان میشود
                                                smsVerificationLoginForm.classList.remove('d-block');
                                                smsVerificationLoginForm.classList.add('d-none');
                                                smsVerificationInputForm.blur();

                                                //فرم ورود کارت حکمت نمایش داده میشود
                                                cardNumberLoginForm.classList.remove('d-none');
                                                cardNumberLoginForm.classList.add('d-block');
                                                cardNumberInputForm.focus();
                                            }
                                        });
                                }
                            }
                            //اگر آدرس url مقدار نداشته باشد
                            else {
                                window.location = '/';
                            }

                        }
                        //اگر کاربر کد 5 رقمی را اشتباه وارد کند
                        else if (data.isSuccess === false) {
                            bootbox.alert(data.result);
                            spinnerElement.classList.add('d-none');
                            submitButton.removeAttribute('disabled');
                        }
                        else {
                            bootbox.alert('لطفا مجددا تلاش کنید.');
                            spinnerElement.classList.add('d-none');
                            submitButton.removeAttribute('disabled');
                        }
                    })
                    .catch(data => {
                        bootbox.alert('لطفا مجددا تلاش کنید.');
                        spinnerElement.classList.add('d-none');
                        submitButton.removeAttribute('disabled');

                    });
            }
        }

        //متد مروبط به ارسال کد 5 رقمی  برای وری فای کد به شماره موبایل کاربر
        function sendVerifyCode() {
            fetch('/api/user/SendVerifyCode/' + '@Model.SendTo',
                {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json; charset=utf-8'
                    },
                })
                .then(response => response.json())
                .then(data => {
                    if (data.isSuccess === true) {

                        $('#frmConfirm').attr('action', data.returnUrl);
                        $('#frmConfirm').submit();

                    }
                    else if (data.isSuccess === false || data.isSuccess == null) {
                        bootbox.alert('لطفا مجددا تلاش کنید.');
                    }
                    else {

                        bootbox.alert('لطفا مجددا تلاش کنید.');
                    }
                })
                .catch(data => {
                    bootbox.alert('لطفا مجددا تلاش کنید.');
                });
        }

        //متد مروبط به رفتن به صفحات مختلف ورود
        //مثل صفحه فراموشی رمز عبور ، صفحه بازگشت
        function goToLoginPage(url) {
            $('#loginForm').attr('action', url);
            $('#loginForm').submit();
        }


        //ثبت شدن حکمت کارت بعد از login
        function submitHekmatCardNumberAfterLogin(event) {
  
            var inputCardNumber = document.querySelector("#card-number").value;
            var buttonCardNumber = document.querySelector("#submit-card-number-btn");

            spinnerElement.classList.remove('d-none');

            if (inputCardNumber.length != 16) {
                bootbox.alert('کارت حکمت 16 رقمی میباشد');
                event.preventDefault();
                event.stopPropagation();
                spinnerElement.classList.add('d-none');
                submitButton.removeAttribute('disabled');
            }
            else {
                const UserCutomerClubToHekmatUrl = '/api/AdditionalUserProp/updateUserCutomerClubToHekmat?hekmatCardNumber=';
                buttonCardNumber.style.cursor = "pointer";

                // Make a GET request
                fetch(UserCutomerClubToHekmatUrl + inputCardNumber, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json; charset=utf-8'
                    },
                })
                    .then(status => {
                        if (!status.ok) {
                            throw new Error('Network response was not ok');
                        }
                        return status.json();
                    })
                    .then(result => {
                        //اگر مقدار کارت حکمت درست باشد پیغام مناسب نمایش داده میشود و ثبت میشود
                        if (result.isSuccess === true) {
                            cardNumberDivAlerForm.classList.remove('d-none');
                            cardNumberDivAlerForm.classList.add('d-block');
                            cardNumberAlerForm.innerText = result.message;
                            event.preventDefault();
                            setTimeout(function () {
                                $('#frmConfirm').submit();
                            }, 3500);
                        }
                        else {
                            bootbox.alert(result.message);
                        }
                    }).catch(error => {
                        bootbox.alert(error.message);
                    })
            }

        }
    </script>

}


