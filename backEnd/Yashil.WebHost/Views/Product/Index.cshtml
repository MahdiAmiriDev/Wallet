<form method="POST" action="/user/login" id="frmConfirm" style="display: none">
    <input type="hidden" name="_back" value="@currentEncryptedUrl" />
</form>


<div class="modal fade rtl" id="preRegisterModal">
    <div class="modal-dialog modal-dialog-centered modal-lg ">
        <div class="modal-content">

