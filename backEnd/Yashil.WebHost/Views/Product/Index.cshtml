@using Yashil.Core.Enums
@using Yashil.Infrastructure.Util
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Http.Extensions
@using Yashil.Common.SharedKernel.Helpers
@model YashilCommerce.Web.Areas.ECommerce.ViewModels.ProductPresentationViewModel
@inject IHttpContextAccessor HttpContextAccessor
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["MetaDescription"] = Model.ProductSalePlanningPresentationViewModel.ProductTitle;
    ViewData["Title"] = Model.ProductSalePlanningPresentationViewModel.ProductTitle;
    var shoppingCartType = (int)ShoppingCartTypeEnum.ShoppingCart;
    var productSalePlanning = Model.ProductSalePlanningPresentationViewModel;
    var representationId = Model.ProductSalePlanningPresentationViewModel.RepresentationId ?? 0;
    var discountPercentage = CurrencyUtility.RemoveDecimal((1 - Model.ProductSalePlanningPresentationViewModel.CalcedPrice
                                                            / Model.ProductSalePlanningPresentationViewModel.Price) * 100);

    var currentEncryptedUrl = CryptographyHelper.Base64Encode(CryptographyHelper.AesEncrypt(HttpContextAccessor.HttpContext?.Request.GetEncodedUrl()));
}


@section meta {
    <meta name="twitter:title" content="@Html.Raw(Model.ProductSalePlanningPresentationViewModel.ProductTitle)">
    <meta name="twitter:label1" content="قیمت به تومان">
    <meta name="twitter:data1" content="@CurrencyUtility.FormatPrice(productSalePlanning.CalcedPrice)">
    <meta property="og:type" content="product">
    <meta property="og:title" content="@Model.ProductSalePlanningPresentationViewModel.ProductTitle">
    <meta property="og:url" content="@Context.Request.Host@Context.Request.Path">
    <meta property="product:condition" content="new">
    <meta property="product:availability" content="in stock">
    <meta property="product:price:amount" content="@CurrencyUtility.FormatPrice(productSalePlanning.CalcedPrice)">
    <meta property="product:price:currency" content="IRR">
}


