                        <label for="national_code">
                            <b class="fs-15">
                                کد ملی فراگیر:
                            </b>
                        </label>
                        <input type="text" class="input-login input-login-page text-left w-100 ss02 input-validation-error" id="national_code" placeholder="
" aria-label="Username" name="national_code" onkeypress=" return isNumber(event)" aria-describedby="basic-addon1" pattern="[0-9]+" maxlength="10" min="10" max="9999999999" required="required">
                        <span class="text-danger2 d-none" id="error-text-national-code">کاربر گرامی فرمت  کد ملی صحیح نمی باشد</span>
                    </fieldset>


                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="cancelingPreRegister()">انصراف</button>
                <button type="button" class="btn confirm-index-product  px-5" onclick="preRegister(@Model.ProductSalePlanningPresentationViewModel.Id)">تایید</button>
            </div>

        </div>
    </div>
</div>

