@model List<YashilCommerce.Web.Areas.ECommerce.ViewModels.OrderListPresentationViewModel>

@if (Model.Count != 0)
{
    @foreach (var item in Model)
    {
        @await Html.PartialAsync("_OrderListItem", item)
    }
}
else
{
    
    <div class="py-3">
        <img src="/images/emptyOrder.svg"
             alt="Empty Order"
             class="mx-auto d-block"
             width="200px"
             height="150px" />
        <p class="text-center fs-16 fw-600">سفارشی در این قسمت وجود ندارد!</p>
    </div>
}