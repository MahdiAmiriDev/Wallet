@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model YashilCommerce.Web.Areas.ECommerce.ViewModels.OrderSummaryViewModel
@{
    Layout = "_Layout";
}

@if (Model == null || !Model.OrderId.HasValue)
{
    return;
}
<section id="tabs" class="mx-auto my-2 printable">
    <div class="container custom-container ss02 pt-2 pt-lg-5 pt-xxl-2">
        <div class="row ">
            <ul class="nav nav-tabs bg-white rounded align-items-center"
                id="myTab"
                role="tablist">
                <div class="ms-3 m-1">
                    <a href="/Order/" data-toggle="tooltip" data-placement="top" title="سفارش های من">
                        <svg viewBox="0 0 20 20" width="30" height="30" stroke="#000">
                            <use href="../images/icons/general.svg#arrow-narrow-right" />
                        </svg>
                    </a>
                </div>
                <li class="nav-item ps-0" role="presentation">
                    <button class="nav-link active text-secondary"
                            id="productDetailTabButton"
                            data-bs-toggle="tab"
                            data-bs-target="#productDetailTabContent"
                            type="button"
                            role="tab"
                            aria-controls="home"
                            aria-selected="true">
                        <svg viewBox="0 0 24 24" width="24" heigth="24" stroke="#6c757d">
                            <use href="../images/icons/general.svg#checklist" />
                        </svg>
                            جزییات سفارش
                    </button>
                </li>
                <li>
                    <span>
                        کدپیگیری:
                        <strong class="text-danger">@Model.Title</strong>
                    </span>

                    <span>
                        سفارش:
                        <strong class="text-danger">@Model.OrderStatusTypeTitle</strong>
                    </span>
                    @if (!string.IsNullOrEmpty(Model.AuthorizationTransactionResult))
                    {
                        <span>
                            نتیجه پرداخت :
                            <strong class="text-danger">@Model.AuthorizationTransactionResult</strong>
                        </span>
                    }
                    @if (Model.OrderSummaryForPayViewModel.SubsidyBased)
                    {
                        <span>
                            یارانه :
                            <strong class="text-danger">@Model.SubsidyStatusTypeTitle</strong>
                        </span>
                    }

                </li>
            </ul>
            <div class="tab-content bg-white" id="tabContent">
                <div class="tab-pane fade show active" id="productDetailTabContent" role="tabpanel"
                     aria-labelledby="home-tab">
                    @await Html.PartialAsync("_OrderSummary", Model)
                </div>
            </div>
        </div>
    </div>
</section>


<!-- The checkRecipient Modal -->
<div class="modal fade rtl" id="paymentMethodInfoModal">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen">
        <div class="modal-content">
            <!-- Modal Header-->
            <div class="modal-header">
                <button type="button" class="btn-close m-0"
                        data-bs-dismiss="modal" data-dismiss="modal" onclick="closeSaminPaymentModal()"></button>
            </div>
            <!-- Modal body -->
            <div class="modal-body" style="min-height:280px">
            </div>
        </div>
    </div>
</div>

<!-- Tab panes -->
@section scripts{


    <script>
        function closeSaminPaymentModal() {
            document.documentElement.classList.remove('overflow-hidden');
        }

        saleConfigurationAttributeSaleTypesIsNotCompatible = @(!Model.OrderSummaryForPayViewModel.SaleType.HasValue ? "true" : "false");
        if (saleConfigurationAttributeSaleTypesIsNotCompatible === true) {
            bootbox.alert('کاربر گرامی، با توجه به متفاوت بودن روش های پرداخت امکان پرداخت وجود ندارد، لطفا محصولات دیگری انتخاب نمایید.');
        }
        $(function() {
            /*
             * Initialise print preview plugin
             */
            // Add link for print preview and intialise
            //$('a.print-preview').printPreview({});
            $('a.print-preview').click(x => {
                window.print();
            });

        });
    </script>

}
}

