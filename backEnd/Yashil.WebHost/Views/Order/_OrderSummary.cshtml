@using Yashil.Core.Enums
@model YashilCommerce.Web.Areas.ECommerce.ViewModels.OrderSummaryViewModel

<div class="container-fluid ">
    <div class="row ">
        <div class="col-12 col-sm-12 col-md-12 col-lg-8 p-3 ">
            @if (!string.IsNullOrEmpty(Model.CustomMessage))
            {
                <div class="invoice-alert-show text-justify">
                    <div class="alert alert-danger" role="alert">
                        <div class="d-flex flex-column">
                            @Html.Raw(Model.CustomMessage)
                        </div>
                    </div>
                </div>
            }
            @if (!Model.OrderId.HasValue)
            {
                @await Component.InvokeAsync("OrdersSubsidyWaitingToBePaidStatistics", new { Model.OrderAddressViewModel.CardNumber, checkOnlyCompletedOrders = false, checkForCurrentUser = false })
                @await Component.InvokeAsync("OrdersSubsidyWaitingToBePaidStatistics", new { Model.OrderAddressViewModel.CardNumber, checkOnlyCompletedOrders = true, checkForCurrentUser = true })
                @await Component.InvokeAsync("OrdersSubsidyWaitingToBePaidStatistics", new { Model.OrderAddressViewModel.CardNumber, checkOnlyCompletedOrders = true, checkForCurrentUser = false })
            }

            @await Component.InvokeAsync("Content", new { pagePosition = PagePositionTypeEnum.OrderSummeryDescriptionOfReceivingProduct, viewName = "_OrderSummeryDescriptions" })

            @if (!Model.OrderIsComplete)
            {
                /*متن توافق نامه*/
                @await Component.InvokeAsync("Content", new { pagePosition = PagePositionTypeEnum.OrderSummeryDescription, viewName = "_OrderSummeryDescriptions" })
            }
            @if (Model.IsWaitingResponseFromHekmatPaymentGateway)
            {
                @await Component.InvokeAsync("Content", new { pagePosition = PagePositionTypeEnum.OrderSummeryWaitingForHekmatConfirm, viewName = "_OrderSummeryDescriptions" })
            }
            @*Addresss View Location*@
            @await Html.PartialAsync("_OrderAddressSummary", Model.OrderAddressViewModel)
            @*Order Item List Location*@
            @await Html.PartialAsync("_OrderItemListSummary", Model.OrderItemDetailPresentationViewModels)
            <div style="text-align: center;font-weight: bold;font-size: 15px; margin-top:0.5rem;">
                @Model.GuidanceText
            </div>
        </div>
        <!-- left sidebar -->
        <div class="col-12 col-sm-12 col-md-12 col-lg-4 p-3 ">
            <div class="sticky-top sticky-top-ziro-index">
                @if (Model.OrderId.HasValue && Model.Funding != null)
                {
                    <div class="detail p-sm-1 p-md-3 rounded mb-2">
                        <div class="d-flex justify-content-between"><span>وضعیت سفارش</span><strong>@Model.OrderStatusTypeTitle</strong></div>
                        <div class="d-flex justify-content-between"><span>پرداخت موفق ثبت‌شده</span><strong>@Model.Funding.RecordedPaidAmount.ToString("N2") تومان</strong></div>
                        <div class="d-flex justify-content-between mt-2"><span>مصرف خالص کیف پول</span><strong>@Model.Funding.WalletNetAmount.ToString("N2") تومان</strong></div>
                        @if (Model.Funding.OpenWalletReservedAmount.HasValue)
                        {
                            <div class="d-flex justify-content-between mt-2"><span>سهم رزروشده کیف پول</span><strong>@Model.Funding.OpenWalletReservedAmount.Value.ToString("N2") تومان</strong></div>
                            <div class="d-flex justify-content-between"><span>سهم درگاه در این تلاش</span><strong>@Model.Funding.OpenGatewayPaymentAmount.Value.ToString("N2") تومان</strong></div>
                            <small class="text-muted">رزرو کیف پول تا زمان تأیید پرداخت، مصرف قطعی نیست.</small>
                        }
                        <small class="text-muted">مبلغ پرداخت موفق پیش از بازپرداخت احتمالی نمایش داده شده است.</small>
                        @if (Model.Funding.PendingVibeCapturePaymentId.HasValue)
                        {
                            <form method="post" action="@Url.Action("RecoverMixed", "VibePayment")">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="paymentId" value="@Model.Funding.PendingVibeCapturePaymentId.Value" />
                                <button type="submit" class="btn btn-warning mt-2">پیگیری ثبت سهم کیف پول</button>
                            </form>
                        }
                        @if (Model.Funding.PendingHekmatOnlineCapturePaymentId.HasValue)
                        {
                            <form method="post" action="/HekmatOnlinePaymentGateway/RecoverMixed">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="paymentId" value="@Model.Funding.PendingHekmatOnlineCapturePaymentId.Value" />
                                <button type="submit" class="btn btn-warning mt-2">پیگیری ثبت سهم کیف پول</button>
                            </form>
                        }
                    </div>
                }
                @if (Model.OrderId.HasValue && (Model.OrderStatusType == (int)OrderStatusTypesEnum.Complete) || Model.OrderStatusType == (int)OrderStatusTypesEnum.IncompletePayment ||
                Model.OrderStatusType == (int)OrderStatusTypesEnum.IncompleteCashAndInstallmentPay)
                {
                    @await Html.PartialAsync("_OrderSuccessFulPaymentListSummary", Model.OrderSuccessFulPaymentListSummary)
                }
                @*Order Summery Location*@
                @await Html.PartialAsync("_OrderSummaryForPay", Model.OrderSummaryForPayViewModel)
            </div>
        </div>
    </div>
</div>
<script>
    saleConfigurationAttributeSaleTypesIsNotCompatible = @(!Model.OrderSummaryForPayViewModel.SaleType.HasValue ? "true" : "false");
    if (saleConfigurationAttributeSaleTypesIsNotCompatible === true) {
        bootbox.alert('کاربر گرامی، با توجه به متفاوت بودن روش های پرداخت امکان پرداخت وجود ندارد، لطفا محصولات دیگری انتخاب نمایید.');
    }


</script>
