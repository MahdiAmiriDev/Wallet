                                        <div class="col-md-6  col-lg-6 col-xs-12 col-sm-12 padding">
                                            <div class="fs-12 w-100 text-right ps-3 position-relative mt-1">
                                                <span>
                                                    @await Component.InvokeAsync("AppConfigValuePresenter", ApplicationConfigKey.YashilCommerceRecipientMobileNumberLabel)
                                                </span>
                                                <span>
                                                    @Model.SelectedRecipient.MobileNumber
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-6  col-lg-6 col-xs-6 col-sm-6 hidden-xs hidden-sm padding">
                                            <div class="fs-12 w-100 text-right ps-3 position-relative mt-1">
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.SelectedRecipient.CardNumber))
