@using Yashil.Core.Enums
@using YashilCommerce.Core.Classes
@using ApplicationConfigKey = YashilCommerce.Core.Classes.ApplicationConfigKey
@inject StoreConfiguration _storeConfiguration;

@model YashilCommerce.Web.Areas.ECommerce.ViewModels.CheckoutViewModel
 
<script>
    function SetRecipient(recipient) {
        if (@Model.AddressBased && (!recipient.FullAddress || recipient.CityId)) {
            bootbox.alert('کاربر گرامی اطلاعات آدرس تحویل گیرنده انتخابی کامل نمی باشد، لطفا با زدن دکمه ویرایش و اصلاح آن اقدام نمایید');
        } else if (!recipient.Name || !recipient.LatName) {
            bootbox.alert('کاربر گرامی اطلاعات نام و نام خانوادگی تحویل گیرنده انتخابی کامل نمی باشد، لطفا با زدن دکمه ویرایش و اصلاح آن اقدام نمایید');
        } else {
            window.location = unescape('@Url.Action("Checkout", "Order", new { recipientId = "{0}" })').format(recipient.Id);
        }

    }
</script>


<div class="content-wrap" style="display: none;">


    <!-- /.content-wrap  -->
    <!-- modal -->
    <!-- modal -->
</div>
<div class="col-md-12 my-3 w-100 ss02" id="RecipientForm2">
