                                                {
                                                    <span>
                                                        شماره کارت
                                                    </span>
                                                }
                                                <span>
                                                    @Model.SelectedRecipient.CardNumber
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-6  col-lg-6 col-xs-6 col-sm-6 hidden-sm hidden-xs padding">
                                            <div class="fs-12 w-100 text-right ps-3 position-relative mt-1">
                                            </div>
                                        </div>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.SelectedRecipient.CityTitle)
