@using Yashil.Core.Enums
@using Yashil.Infrastructure.Util
@model Yashil.Core.CustomViewModels.ECommerce.ProductsByFilterViewModel
@using Yashil.Common.Core.Classes;
@inject ApplicationConfiguration ApplicationConfiguration;
<style>

    .SubsidyBased-main-products {
        border-radius: 5px 5px 0 0;
        margin-bottom: 0px;
    }
</style>


@foreach (var item in Model.ProductSalePlannings)
{
    var onlineClassCss = item.ImplementationType.HasValue && item.ImplementationType == (int)ImplementationTypeEnum.Online ? "online_course" : "";
    var mixedClassCss = item.ImplementationType.HasValue && item.ImplementationType == (int)ImplementationTypeEnum.Mixed ? "mixed_course" : "";
    var discountPercentage = CurrencyUtility.RemoveDecimal((1 - item.Price / item.BasePrice) * 100);

    <article>
        <!-- Skeleton Loading Placeholder for Search Result Product Card -->
        <div class="skeleton-loading--container search-product-container--skeleton w-100 h-100 d-flex justify-content-between overflow-hidden border gap-4" style="background: #F8F7FC; border-radius:10px; padding: 15px">
            <div class="skeleton skeleton-line search-product-image--skeleton"
                 style="
            --lines: 1;
                --l-h: 90px;
        --c-w: 180px;
        --c-p: 0px;
          "></div>
            <div class="w-100 d-flex flex-column gap-3" style="flex: 1">
                <div class="skeleton skeleton-rect search-product-card--skeleton"></div>
                <div class="skeleton skeleton-line search-product-text--skeleton"
                     style="
            --lines: 6;
                --l-h: 15px;
        --c-w: 100%;
        --c-p: 0px;
          "></div>
                <div class="d-flex align-items-center gap-3 w-100">
                    <div class="skeleton skeleton-circle" style="--c-s: 50px;--c-p: 0px;"></div>
                    <div class="skeleton skeleton-line"
                         style="
            --lines: 2;
                --l-h: 15px;
        --c-w: 100%;
        --c-p: 0px;
    flex: 1
          "></div>
                </div>
            </div>
        </div>
        <!-- Skeleton Loading Placeholder for Search Result Product Card /-->

        <!-- Search Result Product Card -->
        <a href="@Url.Action("Index","Product",new{pSpId=item.ProductSalePlanningId})" class="skeleton-content--container d-none product-card__container ss02">
            <div class="product-card position-relative overflow-hidden h-100">
                @if (!string.IsNullOrEmpty(onlineClassCss))
                {
                    <div class="online-product">آنلاین</div>
                }
                @if (!string.IsNullOrEmpty(mixedClassCss))
                {
                    <div class="mixed-products">حضوری / آنلاین</div>
                }
                <div class="image-container">
                    <img class="img-fluid lazy-img product-image position-relative border"
                         src="~/images/placeholder/336x190.png"
                         data-src="@Url.Action("GetProductSalesPlanningImage","PublicApi",new{productSalesPlanningId=item.ProductSalePlanningId, modificationDate = item.ModificationDate})"
                         alt="@item.Title" />
                    @if (item.IsEmployment)
                    {
                        <div class="cover-highlight-Curve-employment position-absolute d-block fs-12 text-white">
                            اشتغال
                        </div>
                    }
                </div>
                <div class="card-body d-flex flex-column justify-content-between">

                    <h5 class="fs-16 card-title pb-0 lh-base flex-fill fw-700 ss02">
                        @if (item.Title.Length > 30)
                        {
                            @: @item.Title.Substring(0, 30)...
                        }
                        else
                        {
                            @item.Title
                        }
                    </h5>

                <div class="d-flex flex-column justify-content-between gap-2 flex-fill">
                    <!-- first div -->
                    <div>
                        <!-- تاریخ -->
                        @if (!string.IsNullOrEmpty(item.StartDateString))
                        {
                            <div class="detail-date d-flex gap-1 align-items-center">
                                <span>
                                    <svg viewBox="0 0 20 20" width="20" heigth="20" stroke="navy">
                                        <use href="../images/icons/product.svg#calendar-time" />
                                    </svg>
                                </span>
                                <strong class="text-strong-products">از</strong>
                                <span class="text-normal-products">@item.StartDateString</span>
                                <strong class="text-strong-products">تا</strong>
                                <span class="text-normal-products">@item.EndDateString</span>
                            </div>
                        }
                        <!-- مدت -->
                        @if (!string.IsNullOrEmpty(item.Duration))
                        {
                            <div>
                                <svg viewBox="0 0 20 20" width="20" height="20" stroke="green">
                                    <use href="../images/icons/product.svg#clock" />
                                </svg>
                                <strong class="text-strong-products">مدت :</strong>
                                <span class="text-normal-products">  @item.Duration ساعت</span>
                            </div>
                        }
                        <!-- زمان بندی دوره -->
                        @if (!string.IsNullOrEmpty(item.CoursePlanningSchedule))
                        {
                            <div>
                                <svg viewBox="0 0 20 20" width="20" height="20" stroke="teal">
                                    <use href="../images/icons/product.svg#watch" />
                                </svg>
                                <span class="text-normal-products">@item.CoursePlanningSchedule.Substring(0, item.CoursePlanningSchedule.Length > 45 ? 45 : item.CoursePlanningSchedule.Length)</span>
                            </div>
                        }
                        <!-- یارانه شاغلین -->
                        @if (Model.SubsidyBased)
                        {
                            <fieldset class="mx-auto rounded-2 text-right fw-600 my-1 employment-subsidy-fieldset">
                            <legend class="employment-subsidy-label">
                                @if (Model.IsResumeFillOutEnough && item.IsEmployment)
                                {
                                    <label>یارانه اشتغال</label>
                                }
                                else
                                {
                                    <label>یارانه</label>
                                }
                                </legend>
                                <div>
                                    <svg viewBox="0 0 20 20" width="20" height="20" stroke="red">
                                        <use href="../images/icons/product.svg#money-bag" />
                                    </svg>
                                    <strong class="text-strong-products fw-800">شاغلین :</strong>
                                    <span class="text-normal-products">
                                        @if (Model.IsResumeFillOutEnough && item.IsEmployment)
                                        {
                                            @CurrencyUtility.FormatPrice(item.MaxEmploymentVezaratSubsidy)
                                        }
                                        else
                                        {
                                            @CurrencyUtility.FormatPrice(item.MaxVezaratSubsidy)
                                        }
                                        تومان
                                    </span>
                                </div>

                                <!-- یارانه بازنشسته ها -->
                                <div>
                                    <svg viewBox="0 0 20 20" width="20" height="20" stroke="brown">
                                        <use href="../images/icons/product.svg#coin" />
                                    </svg>
                                    <strong class="text-strong-products fw-800">بازنشستگان :</strong>
                                    <span class="text-normal-products">
                                        @if (Model.IsResumeFillOutEnough && item.IsEmployment)
                                        {
                                            @CurrencyUtility.FormatPrice(item.MaxEmploymentSataSubsidy)
                                        }
                                        else
                                        {
                                            @CurrencyUtility.FormatPrice(item.MaxSataSubsidy)
                                        }
                                        تومان
                                    </span>
                                </div>
                            </fieldset>
                        }

                            <!-- مکان -->
                            @if (!string.IsNullOrEmpty(item.RepresentationShortName))
                            {
                                <div>
                                    <span>
                                        <svg viewBox="0 0 20 20" width="20" height="20" stroke="purple">
                                            <use href="../images/icons/general.svg#map-pin" />
                                        </svg>
                                    </span>
                                    <strong class="text-strong-products"> @item.CityTitle</strong>
                                    <span class="text-normal-products">@item.RepresentationShortName.Substring(0, item.RepresentationShortName.Length > 25 ? 25 : item.RepresentationShortName.Length)</span>

                                </div>
                            }
                        </div>

                        <!-- second div -->
                        @if (!item.DisableBuyButton)
                        {
                            <div>
                                <div class="d-flex justify-content-between align-item-center pt-3">
                                    <div style="box-shadow: 0 0px 1px 0 rgba(0, 0, 0, 0.2), 0 0px 3px 0 rgba(0, 0, 0, 0.19); border-radius: 5px; max-width: 60px; height: 60px; border-radius: 5px; overflow: hidden;">
                                        <img src="~/images/placeholder/70.png" data-src="@Url.Action("GetCompanyIcon","PublicApi",new { cId = item.CompanyId })"
                                             class="lazy-img"
                                             style="object-fit: cover; height: 100%;"
                                             alt="@item.CompanyTitle" />
                                    </div>

                                    <div>
                                        @if (discountPercentage != "0")
                                        {
                                            <div class="d-flex justify-content-between py-1">
                                                <del class="ss02">@CurrencyUtility.FormatPrice(item.BasePrice)</del>
                                                <span class="badge percent-in-company ss02">%@discountPercentage</span>
                                            </div>
                                        }
                                        <div>
                                            <span class="badge price-in-company ss02">@CurrencyUtility.FormatPrice(item.Price) تومان</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </a>
        <!-- Search Result Product Card /-->
    </article>
}



