<div id="search-component__container" class="position-relative">
    <div id="search-component__placeholder" class="d-flex align-items-center gap-2 px-3">
        <div>
            <svg width="22" height="22" stroke="currentColor">
                <use href="../images/icons/general.svg#search" />
            </svg>
        </div>
        <span class="d-none d-lg-block">جستجو</span>
        <div class="d-flex align-items-center gap-1 d-lg-none">
            <span>جستجو در</span>
            <div class="d-flex align-items-center" style="height: 35px">
                @await Component.InvokeAsync("Logo")
            </div>
        </div>
    </div>
    <div id="search-component" class="d-flex flex-column gap-3 bg-white overflow-hidden">
        <div id="search-input__container" class="d-flex align-items-center gap-2">
            <form id="search-component__form" class="d-flex w-100">
                <div id="search-button" class="d-none d-lg-block pe-1">
                    <svg width="22" height="22" stroke="currentColor">
                        <use href="../images/icons/general.svg#search" />
                    </svg>
                </div>
                <button type="button" id="close-search-component" class="d-lg-none">
                    <svg width="24" height="24" stroke="currentColor">
                        <use href="../images/icons/general.svg#arrow-right" />
                    </svg>
                </button>
                <input id="search-input" type="text" placeholder="جستجو" autocomplete="off" class="w-100" />
            </form>
            <button id="clear-search-input__button" style="transform: rotate(180deg)">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="1.5" stroke="#2c3e50" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M20 5a2 2 0 0 1 1.995 1.85l.005 .15v10a2 2 0 0 1 -1.85 1.995l-.15 .005h-11a1 1 0 0 1 -.608 -.206l-.1 -.087l-5.037 -5.04c-.809 -.904 -.847 -2.25 -.083 -3.23l.12 -.144l5 -5a1 1 0 0 1 .577 -.284l.131 -.009h11zm-7.489 4.14a1 1 0 0 0 -1.301 1.473l.083 .094l1.292 1.293l-1.292 1.293l-.083 .094a1 1 0 0 0 1.403 1.403l.094 -.083l1.293 -1.292l1.293 1.292l.094 .083a1 1 0 0 0 1.403 -1.403l-.083 -.094l-1.292 -1.293l1.292 -1.293l.083 -.094a1 1 0 0 0 -1.403 -1.403l-.094 .083l-1.293 1.292l-1.293 -1.292l-.094 -.083l-.102 -.07z" stroke-width="0" fill="currentColor" />
                </svg>
            </button>
        </div>
        <div id="search-results__container" class="d-flex flex-column gap-4 overflow-auto">
            <div id="search-results-loader__container" class="d-none">
                <span class="search-results-loader"></span>
            </div>
            <div id="search-results-banner__container">
                <img class="search-results-banner" src="~/images/search/background.svg" alt="Search Hero Image" />
            </div>
            <div id="search-results" class="d-none">
                <!-- Template Handled in JavaScript -->
            </div>
