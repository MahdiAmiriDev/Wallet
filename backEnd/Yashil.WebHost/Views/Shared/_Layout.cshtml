    <script type="text/javascript">
        let currentPath = window.location.pathname.slice(1).toLocaleLowerCase();
        const bodyContainer = document.querySelector('body');
        const bottomNavbarElement = document.querySelector('.bottom_navbar');
        const userProfileButton = document.querySelector('#user-profile__button');
        const userProfileContainer = document.querySelector('#user-profile__menu');
        bottomNavbarElement.addEventListener('click', function (e) {
            currentPath = e.target.dataset.tag;
        })
        const navbarElements = Array.from(document.querySelector('.bottom_navbar').querySelectorAll('a'));
        const menuButton = document.getElementById('menu-button');
        navbarElements.forEach(navbarElement => navbarElement.classList.remove('active_tab'));
        const activeNavbarTab = navbarElements.find(navbarElement => navbarElement.dataset.tag === currentPath);
        if (activeNavbarTab) { activeNavbarTab.classList.add('active_tab') };
        if (!activeNavbarTab) { menuButton.classList.add('active_tab') };
        if (userProfileButton) {
            userProfileButton.addEventListener('click', function () {
                userProfileContainer.classList.toggle('user-profile__active')
            })
            bodyContainer.addEventListener('click', function (e) {
                if (e.target.dataset.tag === undefined) {
                    userProfileContainer.classList.remove('user-profile__active')
                }
            })
        }
    </script>

    <script>
        const mapIcon = document.querySelector('.location-icon');

        /* scale کردن آیکن لوکیشن بعد از 0.5 ثانیه */
        const addPulseEffect = setInterval(() => {
            mapIcon.classList.add('pulsing');
        }, 500);

        /* بازگردانی آیکن لوکیشن به حالت اولیه بعد از یک ثانیه */
        const removePulseEffect = setInterval(() => {
            mapIcon.classList.remove('pulsing');
        }, 1000);

        /* پاک کردن افکت ضربان قلب بعد از گذشت 10 ثانیه */
        setTimeout(() => {
            clearInterval(addPulseEffect);
            clearInterval(removePulseEffect);
        }, 10000);
    </script>

