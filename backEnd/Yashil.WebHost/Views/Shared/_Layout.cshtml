    @* Call Statistics API *@
    <script>
        const apiUrlStatistics = '/api/siteVisit/GetSiteVisitInfo';
        const totalVisit = document.getElementById('total-visit');
        const todayVisit = document.getElementById('today-visit');
        const yesterdayVisit = document.getElementById('yesterday-visit');
        // Make a GET request
        fetch(apiUrlStatistics)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                // Display data in an HTML element
                totalVisit.textContent = data.totalSiteVisitCount;
                todayVisit.textContent = data.currentDaySiteVisitCount;
                yesterdayVisit.textContent = data.perviousDayTotalSiteVisitCount;
            })
            .catch(error => {
                console.error('Error:', error);
            });
    </script>



    <script>
                // انتخاب منوی ناوبری شما از طریق کلاس wide-nav-header
        const targetElement = document.querySelector('.wide-nav-header');

        // رنگ آبی روشن فعلی شما
        const lightColor = { r: 114, g: 194, b: 233 }; // معادل #72c2e9
        // رنگ آبی پررنگ برای حالت دم
        const darkColor = { r: 45, g: 100, b: 160 };

        const breatheSpeed = 1.2;

        function animateBackground() {
            if (!targetElement) return; // اگر عنصر پیدا نشد، کد متوقف شود

            const time = Date.now() * 0.001;
            const wave = (Math.sin(time * breatheSpeed) + 1) / 2;

            const currentR = Math.round(lightColor.r + (darkColor.r - lightColor.r) * wave);
            const currentG = Math.round(lightColor.g + (darkColor.g - lightColor.g) * wave);
            const currentB = Math.round(lightColor.b + (darkColor.b - lightColor.b) * wave);

            // نوسان حجم رنگی بین 20 تا 28 درصد برای سمت چپ و 80 تا 72 درصد برای سمت راست
            const leftPercent = 20 + (wave * 8);
            const rightPercent = 80 - (wave * 8);

            targetElement.style.backgroundImage = `linear-gradient(to right, rgb(35 31 85) ${leftPercent}%, rgb(${currentR}, ${currentG}, ${currentB}), rgb(35 31 85) ${rightPercent}%)`;

            requestAnimationFrame(animateBackground);
        }

        animateBackground();
    </script>
</body>
