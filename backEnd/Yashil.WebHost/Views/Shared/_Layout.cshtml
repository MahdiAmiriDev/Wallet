        const categoriesButton = document.getElementById('mega-menu');
        const headerEl = document.getElementById('header');
        const wideNavHeaderEl = document.querySelector('.wide-nav-header');
        const mainContent = document.querySelector('body');

        fadeOverlay.addEventListener('click', function () {
            searchComponentElement.classList.remove('show');
            fadeOverlay.classList.remove('show');
            mainContent.classList.remove('overflow-hidden');
        });

        categoriesButton.addEventListener('mouseover', function () {
            searchComponentElement.classList.remove('show');
            mainContent.classList.remove('overflow-hidden');
            fadeOverlay.classList.add('show');
            headerEl.classList.add('hovered');
            mainContent.classList.add('hovered');
            $('.wide-nav-header').css('padding-right', function (index, curValue) {
                return parseInt(curValue, 10) + 14 + 'px';
            });
        });
        categoriesButton.addEventListener('mouseout', function () {
            fadeOverlay.classList.remove('show');
            headerEl.classList.remove('hovered');
            mainContent.classList.remove('hovered');
            $('.wide-nav-header').css('padding-right', function (index, curValue) {
                return parseInt(curValue, 10) - 14 + 'px';
            });
        })

