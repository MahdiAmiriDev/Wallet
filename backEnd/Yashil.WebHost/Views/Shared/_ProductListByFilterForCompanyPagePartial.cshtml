@using YashilCommerce.Core.Classes
@model YashilCommerce.Web.Areas.ECommerce.ViewModels.ProductListPartialViewModel
<link rel="stylesheet" href="/css/swiper-bundle.min.css" asp-append-version="true">

<section class="flat-popular-courses style4 " style="text-align:left !important; height:max-content;">
    <div class="" style="">
        <div class="flat-title flat-text-center">
            <h2 class="title" style="font-size: 15px; text-align: right;">
                <i class="@Model.CategoryViewModel.CssClass" aria-hidden="true"></i>
                <span class="grade">@await Component.InvokeAsync("AppConfigValuePresenter", ApplicationConfigKey.YashilCommerceCategoryPrefixLabel)</span> <span class="color-ec5252"> @Model.CategoryViewModel.Title</span>
            </h2>
            <hr />
        </div>
    </div>

    <div class="swiper-container" style="position:relative;z-index:0;">
        <div class="swiper-wrapper">
            @await Component.InvokeAsync("ProductsByFilter", new { productFilter = Model.ProductFilter, groupedCategoryId = Model.CategoryViewModel.Id })
        </div>
        <div class="row">
            <div class="col-md-9 col-lg-9 hidden-sm hidden-xs">
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
            <div class="col-md-3 col-lg-3">
                <a class="btn btn-default ShowProductList" href="@Url.Action("Index", "Company", 
                                                             new {
                                                                 categoryId=Model.CategoryViewModel.Id,
                                                                 cityId=Model.ProductFilter.CityId,
                                                                 representationId= Model.ProductFilter.RepresentationId,
                                                                 categoryGroupId =Model.ProductFilter.CategoryGroupId,
                                                                 company = Model.ProductFilter.Company })">
                    <i class="fad fa-bars" aria-hidden="true"> </i> <span class="fullProductList">فهرست کامل </span>
                </a>
            </div>
        </div>

    </div>
</section>
<script src="/js/swiper-bundle.min.js" asp-append-version="true"></script>
<script>
    var swiper = new Swiper('.swiper-container', {
        //slidesPerView: 5.1,
        breakpoints: {
            320: {
                slidesPerView: 1.1
            },
            480: {
                slidesPerView: 2.1
            },
            640: {
                slidesPerView: 4.1
            }
        },
        direction: getDirection(),
        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        }
    });

    function getDirection() {
        var windowWidth = window.innerWidth;
        var direction = window.innerWidth <= 760 ? 'horizontal' : 'horizontal';

        return direction;
    }
</script>