<!-- محصولات با بیشترین تخفیف را نمایش میدهد -->
<div class="container">
    <div class="bg-white my-3 sale-product-carousel mx-3 mx-sm-0">
        <div class="d-flex justify-content-center align-items-center mt-2 mb-3 p-1 align-text-center gap-1">
            <svg width="30" height="30" stroke="var(--dark-primary-yellow-color)">
                <use href="../images/icons/general.svg#discount"></use>
            </svg>
            <h4 class="mb-0" style="font-size: 23px; font-weight: 600">
                محصولات با بیشترین تخفیف
