@model List<Yashil.Core.CustomViewModels.CityTitleOnlyViewModel>

@{
    if (Model == null)
    {
        return;
    }
}

<div class="sidebar-section border mb-2">
    <div class="sidebar-section__header" style="border-top-right-radius: 10px; border-top-left-radius: 10px;">
        <label for="citys" class="sidebar-section__title">شهر</label>
    </div>
    <hr class="m-0" />
    @if (Model.Count > 15)
    {
        <div class="sidebar-section__content">
            <select id="city-list" name="city" style="width:100%;">
                <option></option>
                @foreach (var item in Model)
                {
                    <option value="@item.Data">@item.Value</option>
                }
            </select>
        </div>
    }
    else
    {
        @foreach (var city in Model)
        {
            <div onclick="insertParam('cityId',@city.Data)" class="form-check" style="cursor:pointer;">
                <label class="form-check-labell"
                       style="margin-top: 10px;">@city.Value</label>
            </div>
        }
    }
</div>

<script type="text/javascript">
    // Initialize City List Dropdown
    createSelect2Dropdown('#city-list', 'لطفا شهر را انتخاب کنید');
    $('#city-list').on('select2:select', retrieveCityListValue)

    function retrieveCityListValue(e) {
        const data = e.params.data;
        const cityId = data.id;
        insertParam('cityId', cityId);
    }
</script>