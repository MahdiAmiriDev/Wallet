@using Yashil.Core.Enums
@using Yashil.Infrastructure.Util
@model Yashil.Core.CustomViewModels.ECommerce.ProductsByFilterViewModel

<link rel="stylesheet" href="~/css/company_loading_skeleton.css" asp-append-version="true" />

@if (Model.ProductSalePlannings.Count == 0)
{
    if (Model.ShowNoResultOnEmpty == true)
    {
        @await Html.PartialAsync("_NoResultProductPartial")
    }
}
else if (Model.ProductSalePlannings.Count > 0)
{

    @*کامپوننت مربوط به ProductVerticalListViewComponent هم با همین نام _ProductsByFilter ایجاد و استفاده شده است  *@
    if (Model.ShowProductsByList == true)
    {
        @await Html.PartialAsync("_ProductListPartial", Model)
    }
    else
    {
        @foreach (var item in Model.ProductSalePlannings)
        {
            var onlineClassCss = item.ImplementationType.HasValue && item.ImplementationType == (int)ImplementationTypeEnum.Online ? "online_course" : "";
            var discountPercentage = CurrencyUtility.RemoveDecimal((1 - item.Price / item.BasePrice) * 100);
            <div class="swiper-slide bg-white overflow-hidden" style="border:solid 1px #c7c7c7;border-radius: 10px; height: auto !important">
                <!-- Skeleton Loading Placeholder for Product Card -->
                <div class="skeleton-loading--container w-100 h-100 d-flex flex-column align-items-center justify-content-between gap-4" style="background: #F8F7FC; padding: 15px">
                    <div class="skeleton skeleton-rect product-card--skeleton"></div>
                    <div class="d-flex align-items-center gap-3 w-100">
                        <div class="skeleton skeleton-circle" style="--c-s: 50px;--c-p: 0px;"></div>
                        <div class="skeleton skeleton-line"
                             style="
            --lines: 2;
                --l-h: 15px;
        --c-w: 100%;
        --c-p: 0px;
    flex: 1
          "></div>
                    </div>
                </div>
                <!-- Skeleton Loading Placeholder for Product Card /-->

                <!-- Product Card -->
                <a class="skeleton-content--container d-none h-100 d-flex text-center ss02"
                   href="@Url.Action("Index","Product",new{pSpId=item.ProductSalePlanningId})">
                    <div class="d-flex flex-column cursor-pointer w-100">
                        <div class="@onlineClassCss" style="text-align: center;">
                            <img src="~/images/placeholder/300.png" data-src="@Url.Action("GetProductSalesPlanningImage","PublicApi",new{productSalesPlanningId=item.ProductSalePlanningId, modificationDate = item.ModificationDate})" class="w-100 lazy-img position-relative" alt="@item.Title" style="aspect-ratio:1.9; border-bottom: 1px solid #00000014; object-fit: cover" />
                        </div>
                        @if (item.IsEmployment)
                        {
                            <div class="cover-highlight-Curve-employment position-absolute d-block fs-12 text-white ">
                                اشتغال
                            </div>
                        }
                        <div class="d-flex align-items-start justify-content-between flex-column p-2 mt-4" style="flex:1">
                            <div class="d-flex flex-column gap-4 w-100">
                                <div class="align-self-center">
                                    <div class="fs-15 fw-bold">
                                        <span>
                                            @if (item.Title.Length > 40)
                                            {
                                                @: @item.Title.Substring(0, 35)...
                                            }
                                            else
                                            {
                                                @item.Title
                                            }

                                        </span>
                                    </div>
                                </div>
                                <div class="d-flex align-items-start flex-column" style="row-gap: 4px;">
                                    @if (!string.IsNullOrEmpty(item.StartDateString))
                                    {
                                        <div>
                                            <div class="text-right">
                                                <span>
                                                    <svg viewBox="0 0 20 20" width="20" heigth="20" stroke="navy">
                                                        <use href="../images/icons/product.svg#calendar-time" />
                                                    </svg>
                                                </span>
                                                <span class="fs-14">
                                                    <span class="fw-bold">از</span> @item.StartDateString
                                                    <span class="fw-bold">تا</span> @item.EndDateString
                                                </span>
                                            </div>

                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Duration))
                                    {
                                        <div class="text-right">
                                            <div class="fs-13">
                                                <span>
                                                    <svg viewBox="0 0 20 20" width="20" height="20" stroke="green">
                                                        <use href="../images/icons/product.svg#clock" />
                                                    </svg>
                                                    <span class=""> مدت:</span>
                                                </span>
                                                <span class="">
                                                    @item.Duration ساعت
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.RepresentationShortName))
                                    {
                                        <div class="text-right">
                                            <div class="fs-13">
                                                <span>
                                                    <svg viewBox="0 0 20 20" width="20" height="20" stroke="teal">
                                                        <use href="../images/icons/product.svg#watch" />
                                                    </svg>
                                                </span>

                                                @if (!string.IsNullOrEmpty(item.CoursePlanningSchedule))
                                                {
                                                    var representationCustomName = String.Concat(item.RepresentationShortName + " - ", item.CoursePlanningSchedule);

                                                    <span>@representationCustomName.Substring(0, representationCustomName.Length > 25 ? 25 : representationCustomName.Length)</span>
                                                    @if (representationCustomName.Length > 25)
                                                    {
                                                        <span>...</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>@item.RepresentationShortName</span>
                                                }
                                            </div>
                                        </div>
                                    }


                                    @if (Model.SubsidyBased)
                                    {

                                        <fieldset class="mx-auto rounded-2 text-right fw-600 my-1 employment-subsidy-fieldset">
                                            <legend class="employment-subsidy-label">
                                                @if (Model.IsResumeFillOutEnough && item.IsEmployment)
                                                {
                                                    <label>یارانه اشتغال</label>
                                                }
                                                else
                                                {
                                                    <label>یارانه</label>
                                                }
                                            </legend>





                                            <div class="text-right ">
                                                <div class="fs-13">
                                                    <span>
                                                        <svg viewBox="0 0 20 20" width="20" height="20" stroke="red">
                                                            <use href="../images/icons/product.svg#money-bag" />
                                                        </svg>
                                                    </span>
                                                    <span>  شاغلین: </span>
                                                    @if (Model.IsResumeFillOutEnough && item.IsEmployment)
                                                    {

                                                        <span>
                                                            @CurrencyUtility.FormatPrice(item.MaxEmploymentVezaratSubsidy)
                                                            تومان
                                                        </span>
                                                    }
                                                    else
                                                    {

                                                        <span>
                                                            @CurrencyUtility.FormatPrice(item.MaxVezaratSubsidy)
                                                            تومان
                                                        </span>
                                                    }

                                                </div>
                                            </div>
                                            <div class="text-right">
                                                <div class="fs-13">
                                                    <span>
                                                        <svg viewBox="0 0 20 20" width="20" height="20" stroke="brown">
                                                            <use href="../images/icons/product.svg#coin" />
                                                        </svg>
                                                    </span>
                                                    <span>  بازنشستگان: </span>
                                                    @if (Model.IsResumeFillOutEnough && item.IsEmployment)
                                                    {
                                                        <span>
                                                            @CurrencyUtility.FormatPrice(item.MaxEmploymentSataSubsidy) تومان
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span>
                                                            @CurrencyUtility.FormatPrice(item.MaxSataSubsidy) تومان
                                                        </span>
                                                    }


                                                </div>
                                            </div>
                                        </fieldset>
                                    }

                                    @if (!string.IsNullOrEmpty(item.RepresentationShortName))
                                    {
                                        <div class="text-right">
                                            <div class="fs-13">
                                                <span>
                                                    <svg viewBox="0 0 20 20" width="20" height="20" stroke="purple">
                                                        <use href="../images/icons/general.svg#map-pin" />
                                                    </svg>
                                                </span>
                                                <span class="">@item.CityTitle</span>
                                                @*<span class="">-@item.RepresentationShortName</span>*@
                                                <span class="">@item.RepresentationShortName.Substring(0, item.RepresentationShortName.Length > 0 ? 0 : item.RepresentationShortName.Length) </span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center w-100 mt-3">
                                <div class="" style=" box-shadow: 0 0px 1px 0 rgba(0, 0, 0, 0.2), 0 0px 3px 0 rgba(0, 0, 0, 0.19); border-radius:5px">
                                    <img alt="@item.CompanyTitle" src="~/images/placeholder/300.png" data-src="@Url.Action("GetCompanyIcon","PublicApi",new { cId = item.CompanyId })" asp-append-version="true" style="max-width: 60px; height:60px; border-radius: 5px; object-fit: scale-down" class="lazy-img" />
                                </div>
                                <div>
                                    @if (!item.DisableBuyButton)
                                    {
                                        @if (discountPercentage != "0")
                                        {
                                            <div class="">
                                                <div class="text-align-last-left fs-14">
                                                    <span class=" ">
                                                        <s style=""> @CurrencyUtility.FormatPrice(item.BasePrice)</s>
                                                    </span>
                                                    <span class="badge discount-percent-in-company fs-12">%@discountPercentage </span>
                                                </div>
                                            </div>
                                        }
                                        <div class="">
                                            <div style="margin-top:2px;" class="text-align-last-left mt-1">
                                                <span class="courseDetaill rounded-2">@CurrencyUtility.FormatPrice(item.Price) تومان</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
                <!-- Product Card /-->
            </div>
        }
    }
}
