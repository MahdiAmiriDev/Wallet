@model YashilCommerce.Web.Areas.ECommerce.ViewModels.CourseCarouselWithImageHorizontalViewModel

@using Yashil.Infrastructure.Util

@{
    string courseImageUrl = "/api/PublicApi/GetProductSalesPlanningImage?productSalesPlanningId=";
    string companyIconUrl = "/api/PublicApi/GetCompanyIcon?cId=";
}

<section class="candidate-section py-3 my-4">
    @if (Model != null)
    {
        <div class="container">
            <div class="sale-product-carousel mx-3 mx-sm-0" id="@Model.CarouselName-parentdiv">
                <div class="swiper swiper-container" id=@($"swiperContainer{Model.CarouselName}")>
                    <div class="swiper-wrapper">
                        @foreach (var item in Model.CompanyProductSalesPlanningViewModel)
                        {
                            <div class="swiper-slide" style="height: auto">
                                <article class="h-100 w-100">
                                    @if (item.Id == -1)
                                    {
                                        <div class="d-flex flex-column align-content-center">
                                            <p class="text-carousel">@Model.CarouselTitle</p>
                                            <img class="carousel-image lazy-img" alt="carousel image" id="@Model.CarouselName-img">
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- Skeleton Loading Placeholder for Horizontal Carousel Slide -->
                                        <div class="skeleton-loading--container w-100 h-100 d-flex flex-column align-items-center justify-content-between gap-4" style="background: #F8F7FC; padding: 15px">
                                            <div class="skeleton skeleton-rect"
                                                 style="
                        --rect-h: 95px;
              --c-w: 100%;
              --lines: 3;
              --l-h: 15px;
    --c-p: 0px;
              right: 0;
              top: 0;
              z-index: 1;
                  "></div>
                                            <div class="d-flex align-items-center gap-3 w-100">
                                                <div class="skeleton skeleton-circle"
                                                     style="--c-s: 50px;--c-p: 0px;"></div>
                                                <div class="skeleton skeleton-line"
                                                     style="
            --lines: 2;
                --l-h: 15px;
        --c-w: 100%;
        --c-p: 0px;
    flex: 1
          "></div>
                                            </div>
                                        </div>
                                        <!-- Skeleton Loading Placeholder for Horizontal Carousel Slide /-->

                                        <!-- Horizontal Carousel Slide -->
                                        <a class="skeleton-content--container d-none d-flex h-100 w-100" target="_blank" href="/Product?pSpId=@item.Id">
                                            <div class="condidate-item card-item d-flex flex-column h-100 w-100">
                                                <div class="course-img-box img-course">
                                                    <div class="img-vline d-flex align-items-center position-relative">
                                                        <img data-src=@($"{courseImageUrl}{item.Id}&modificationDate={item.ModificationDate}") alt="Secondary Color" class="imgCourse" style="aspect-ratio: 1.9; object-fit: cover" />
                                                    </div>
                                                    @if (item.IsEmployment)
                                                    {
                                                        <div class="cover-highlight-Curve-employment position-absolute d-block fs-12 text-white ">
                                                            اشتغال
                                                        </div>
                                                    }
                                                </div>
                                                <div class="h-100 d-flex flex-column justify-content-between">
                                                    <div class="candidat-text">
                                                        <h5 class="title-product ss02">@item.ProductTitle</h5>
                                                    </div>
                                                    <div class="d-flex align-items-center justify-content-around bg-white">
                                                        <div class="img-icon" style="max-width:52px">
                                                            <img src="" data-src=@($"{companyIconUrl + item.CompanyId}&modificationDate={item.ModificationDate}") alt="Secondary Color" width="100%" />
                                                        </div>
                                                        <div class="pt-1 d-flex flex-column align-items-stretch justify-content-between ss02">
                                                            <div class="d-flex align-items-center justify-content-between align-self-end me-1">
                                                                <div class="d-flex align-items-center justify-content-end text-h5">
                                                                    <span class="text-dark fs-6">@CurrencyUtility.FormatPrice(item.CalcPrice)</span>
                                                                    <svg width="20" height="20" viewBox="0 0 16 16">
                                                                        <use href="../images/icons/general.svg#currency" />
                                                                    </svg>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex align-items-center justify-content-between mb-2">
                                                                <div class="text-decoration-line-through align-self-end mr-auto" style="color: #c0c2c5">
                                                                    @CurrencyUtility.FormatPrice(item.Price)
                                                                </div>
                                                                <div class=" mx-1 px-1 color-white radius-4 d-flex align-items-center justify-content-center ProductPrice discount-percent-in-home">
                                                                    <span class="text-body2-strong color-white">@item.DiscountPercentage%</span>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </a>
                                        <!-- Horizontal Carousel Slide /-->
                                    }
                                </article>
                            </div>
                        }
                    </div>
                </div>
                <div id=@($"next{Model.CarouselName}") class="swiper-button-next d-none d-lg-flex"></div>
                <div id=@($"perv{Model.CarouselName}") class="swiper-button-prev d-none d-lg-flex"></div>
            </div>
        </div>
    }
</section>

<script>
    var courseSwiper = new Swiper(@($"swiperContainer{Model?.CarouselName}"), {

        navigation: {
            nextEl: @($"perv{Model?.CarouselName}"),
            prevEl: @($"next{Model?.CarouselName}")
                                                    },
        centeredSlides: false,
        keyboard: {
            enabled: false
        },
        freeMode: {
            enabled: true,
        },
        breakpoints: {
            200: {
                slidesPerView: 1.5,
                spaceBetween: 10
            },
            356: {
                slidesPerView: 1.8,
                spaceBetween: 10
            },
            425: {
                slidesPerView: 2.2,
                spaceBetween: 10
            },
            500: {
                slidesPerView: 2.6,
                spaceBetween: 10
            },
            570: {
                slidesPerView: 3,
                spaceBetween: 10
            },
            640: {
                slidesPerView: 3.1,
                spaceBetween: 10
            },
            700: {
                slidesPerView: 3.2,
                spaceBetween: 10
            },
            770: {
                slidesPerView: 3.7,
                spaceBetween: 10
            },
            850: {
                slidesPerView: 4,
                spaceBetween: 10
            },
            950: {
                slidesPerView: 4.4,
                spaceBetween: 10
            },
            1050: {
                slidesPerView: 4.8,
                spaceBetween: 10
            },
            1250: {
                slidesPerView: 6.2,
                spaceBetween: 10
            }
        }
    });
</script>
