@using YashilCommerce.Web.Areas.ECommerceAdminApi.ViewModels
@model List<ProductTagsSimpleViewModel>


    @if (Model != null && Model.Count > 0)
    {
        <div class="card mt-3 ">
            <div class="card-header card-header-case-box-into-products-shoping-item2 ">
            <svg width="27px" height="27px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="#CCCCCC" stroke-width="1.344"></g><g id="SVGRepo_iconCarrier"> <path d="M11 7L8 17" stroke="#ed7900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M16 7L13 17" stroke="#ed7900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M18 10H7" stroke="#ed7900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M17 14H6" stroke="#ed7900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> <path d="M22 12C22 16.714 22 19.0711 20.5355 20.5355C19.0711 22 16.714 22 12 22C7.28595 22 4.92893 22 3.46447 20.5355C2 19.0711 2 16.714 2 12C2 7.28595 2 4.92893 3.46447 3.46447C4.92893 2 7.28595 2 12 2C16.714 2 19.0711 2 20.5355 3.46447C21.5093 4.43821 21.8356 5.80655 21.9449 8" stroke="#ed7900" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
                <span class="fw-bold fs-16 title-inner-case-box-into-products">برچسب های مرتبط</span>
            </div>
            <div class="bg-shopping-cart-item-tags">
                <div class="card-body cover-bg-shopping-cart-item-tags">

                @foreach (var tag in Model)
                    {
                        <p asp-append-version="true" class="m-1 badge bg-secondary fs-13 w-auto">
                            # @tag.Title
                        </p>
                    }
                </div>
            </div>
        </div>

    }
