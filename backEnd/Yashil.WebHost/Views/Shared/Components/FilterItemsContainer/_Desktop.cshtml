@model Yashil.Core.CustomViewModels.ECommerce.ProductFilter



@if (Model != null && (Model.CityId.HasValue ||
                       Model.CategoryId.HasValue ||
                      Model.CategoryGroupId.HasValue ||
                      Model.RepresentationId.HasValue ||
                       !string.IsNullOrEmpty(Model.CompanyTitle)))
{
    <div class="sidebar-section overflow-hidden border mb-2">
        <div class="sidebar-section__header d-flex justify-content-between align-items-center">
            <a href="javascript:void(0)" class="closebtn d-lg-none" style="font-size: 30px !important" onclick="closeAdvancedFilter()">
                &times;
            </a>
            <label class="sidebar-section__title">فیلترهای اعمال شده</label>
            <a class="delete-btn fs-12 delete-filter-in-sidebar fw-bold" onclick="deleteFilters()" href="@Url.Action("Index","Company")">
                <p class="mb-0">حذف</p>
                <div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 7h16" />
                        <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
                        <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
                        <path d="M10 12l4 4m0 -4l-4 4" />
                    </svg>
                </div>
            </a>
        </div>
        <hr class="m-0" />
        <div class="sidebar-section__content d-inline-flex flex-wrap align-center gap-2">
            @if (Model.CityId.HasValue)
            {
                <div class="filter-tag border">
                    <span class="filter-tag__title" id="citySelectedName">@Model.CityName</span>
                    <button class="filter-tag__icon" onclick="removeParam('cityId')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M18 6l-12 12" />
                            <path d="M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
            @if (Model.CategoryId.HasValue)
            {
                <div class="filter-tag border">
                    <span class="filter-tag__title">@Model.CategoryTitle</span>
                    <button class="filter-tag__icon" onclick="removeParam('categoryId')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M18 6l-12 12" />
                            <path d="M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
            @if (Model.CategoryGroupId.HasValue)
            {
                <div class="filter-tag border">
                    <span class="filter-tag__title">@Model.CategoryGroupTitle</span>
                    <button class="filter-tag__icon" onclick="removeParam('categoryGroupId')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M18 6l-12 12" />
                            <path d="M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.CompanyTitle))
            {
                <div class="filter-tag border">
                    <span class="filter-tag__title">@Model.CompanyTitle</span>
                    <button class="filter-tag__icon" onclick="removeParam('company')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M18 6l-12 12" />
                            <path d="M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
            @if (Model.RepresentationId.HasValue)
            {
                <div class="filter-tag border">
                    <span class="filter-tag__title">@Model.RepresentationTitle</span>
                    <button class="filter-tag__icon" onclick="removeParam('representationId')">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M18 6l-12 12" />
                            <path d="M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>
}

<script src="~/js/components/filterItemsContainer.js" asp-append-version="true"></script>