@model YashilCommerce.Web.Areas.ECommerce.ViewModels.ProductListPartialViewModel
@{
    bool allowSearch = !string.IsNullOrWhiteSpace(Model.ProductFilter.SearchTitle) && Model.ProductFilter.SearchTitle.Length > 1 && Model.ProductFilter.SearchTitle.Length < 50;
}
<section class="flat-popular-courses style4 mx-1" style="text-align:left !important; height:max-content;">
    <div>
        <div class="flat-title flat-text-center">
            <h2 class="title" style="font-size: 15px;text-align: right;">
                <span style="font-weight:300;color: darkcyan;">
                    <div class="alert alert-success" id="searchResult" role="alert">
                        @if (allowSearch)
                        {
                            @: عبارت مورد جستجو: <span id="searchSegment" style=""><a href="/" class="removeFilter" data-toggle="tooltip" data-placement="top" title="حذف فیلترها" style=""><image src="/images/cross.png" style="width:10px;height:10px;margin-right:5px" /></a><span style="padding-left: 5px; padding-right:5px">@Model.ProductFilter.SearchTitle</span>  </span>
                        }
                        else
                        {
                            @:خواهشمندیم برای جستجو عبارت دقیقتری وارد کنید
                        }
                    </div>
                </span>

            </h2>
            <hr />
        </div>
    </div>
</section>

@if (allowSearch)
{
    @await Html.PartialAsync("_ProductListByFilterPartial",new YashilCommerce.Web.Areas.ECommerce.ViewModels.ProductListPartialViewModel { ProductFilter = Model.ProductFilter,ShowProductsByList = true,ShowNoResultOnEmpty=true})
}