@using Yashil.Core.Enums
@model YashilPayment.Web.Areas.PaymentAdminApi.ViewModels.VerifyHybridPaymentViewModel
@{
    Layout = "_HekmatIpgLayout";
}


<div class="container">
    <div class="row">

        <div class="container dir-rtl  mt-3  mb-3">
            <div class="bg-white d-flex pt-1 ps-1 pe-1 rounded-2 justify-content-between align-items-center flex-column position-relative">
                <div class="order-0 top-lg-40">
                    <div class="pt-3 pt-lg-0 text-center">
                        <span class="fs-20-px">درگاه پرداخت اینترنتی شرکت انستیتوایزایران</span>
                    </div>
                </div>
                <div class="order-1 d-flex justify-content-between  align-items-center w-100 mt-2 mt-lg-0">
                    <img src="/images/HekmatIpg/hekmat.jpg" alt="Hekmat Logo" class="w-50-m-1 w-lg-auto ms-1 img-fluid" />
                    <img src="/images/HekmatIpg/inst.png" alt="Institute Logo" class="w-50-m-1 w-lg-auto me-1 img-fluid" />
                </div>
                <div class="order-2 overflow-hide h-50-px w-100 position-relative d-flex justify-content-center align-items-end">
                    <div class="bg-svg">
                        <span class="text-white">www.tbao.ir</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="beh-card carddetail">
                <div class="background-overflow">
                    <span class="shape"></span>
                </div>
                <div class="card-headerr">
                    <h3>تکمیل اطلاعات پرداخت</h3>
                    <div style=" display: flex; ">
                        <div style=" width: 45px; color:darkblue">
                            <span id="remaining-time"></span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="container-fluid">
                        <div class="row rtl">
                            <div class="col-md-12 col-lg-12 col-xs-12 col-sm-12 px-4 my-3">
                                @if (Model.HybridPaymentStatusTypeEnum == HybridPaymentStatusTypeEnum.WaitingResponseFromPaymentGateway)
                                {
                                    <div class="verifyPayment"></div>
                                    <div class="c-checkout-empty__title">
                                    </div>
                                }
                                else if (Model.HybridPaymentStatusTypeEnum == HybridPaymentStatusTypeEnum.Cancel || Model.HybridPaymentStatusTypeEnum == HybridPaymentStatusTypeEnum.Unsuccessful)
                                {
                                    <div class="cancelPayment"></div>
                                    <div class="c-checkout-empty__title font-weight-bold" style="color:red">
                                        کاربر گرامی پرداخت شما ناموفق بود...
                                    </div>
                                }
                                else if (Model.HybridPaymentStatusTypeEnum == HybridPaymentStatusTypeEnum.Paid)
                                {
                                    <div class="verifyPayment"></div>
                                    <div class="c-checkout-empty__title font-weight-bold" style="color:darkgreen">
                                        کاربر گرامی پرداخت شما انجام شد...
                                    </div>
                                }


                            </div>

                            <div class="col-md-12">
                                <div class="mt-3 text-center" style="color: darkblue">
                                    @if (!string.IsNullOrEmpty(Model.Message))
                                    {
                                        <label for="TRStates"> وضعیت تراکنش:</label>
                                        <label ID="TRStates" runat="server">@Model.Message</label>
                                        <br />
                                    }
                                    @if (!string.IsNullOrEmpty(Model.ReservationNumber))
                                    {
                                        <label for="ResNum"> شماره تراکنش نقدی یا اقساطی:</label>
                                        <label ID="ResNum" runat="server">@Model.ReservationNumber</label>
                                        <br />
                                    }
                                    @if (!string.IsNullOrEmpty(Model.HybridPaymentRequestTitle))
                                    {
                                        <label for="OrderNum"> شماره پیگیری تراکنش ترکیبی:</label>
                                        <label ID="OrderNum" runat="server">@Model.HybridPaymentRequestTitle</label>
                                        <br />
                                    }
                                    @if (!string.IsNullOrEmpty(Model.CustomerRefNum))
                                    {
                                        <label for="RRN"> شماره بازیابی:</label>
                                        <label ID="RRN" runat="server">@Model.CustomerRefNum</label>
                                        <br />
                                    }
                                    @if (!string.IsNullOrEmpty(Model.RefrenceNumber))
                                    {
                                        <label for="RefNum"> شماره پیگیری تراکنش درگاه نقدی یا اقساطی:</label>
                                        <label ID="RefNum" runat="server">@Model.RefrenceNumber</label>
                                        <br />
                                    }
                                    <br />
                                    <div class="c-checkout__to-shipping-sticky directionLtr my-3">
                                        <button id="btnReturnToMerchantSite" class="btn btn-outline-primary " onclick="returnToMerchantSite();">
                                            بازگشت به سایت پذیرنده
                                        </button>
                                    </div>
                                </div>

                                <form class="card-info" id="completePaymentForm" method="post" action="@Model.CallBackUrl" oncopy="return false" oncut="return false" onpaste="return false" style="visibility: hidden">

                                    @if (Model.HybridPaymentStatusResultModel != null)
                                    {
                                        <input type="hidden" name="ReservationNumber" value="@Model.HybridPaymentStatusResultModel?.ReservationNumber" />
                                        <input type="hidden" name="ReferenceNumber" value="@Model.HybridPaymentStatusResultModel?.ReferenceNumber" />
                                        <input type="hidden" name="ErrorCode" value="@Model.HybridPaymentStatusResultModel?.ErrorCode" />
                                        <input type="hidden" name="StatusCode" value="@Model.HybridPaymentStatusResultModel?.StatusCode" />
                                        <input type="hidden" name="Message" value="@Model.HybridPaymentStatusResultModel?.Message" />
                                        <input type="hidden" name="PaidDate" value="@Model.HybridPaymentStatusResultModel?.PaidDate" />
                                        <input type="hidden" name="CahPaymentPercentage" value="@Model.HybridPaymentStatusResultModel?.CahPaymentPercentage" />
                                        <input type="hidden" name="installmentCount" value="@Model.HybridPaymentStatusResultModel?.InstallmentCount" />
                                        <input type="hidden" name="hekmatPayments" value="@Model.HybridPaymentStatusResultModel?.HekmatPayments" />
                                        <input type="hidden" name="onlinePayments" value="@Model.HybridPaymentStatusResultModel?.OnlinePayments" />
                                        <input type="hidden" name="amount" value="@Model.Amount" />
                                        <input type="hidden" name="paymentMethodType" value="@Model.PaymentMethodType" />
                                        <input type="hidden" name="hybridPaymentId" value="@Model.HybridPaymentId" />
                                        <input type="hidden" name="basePrice" value="@Model.BasePrice" />
                                        <input type="hidden" name="isHybrid" value="@Model.UseFormula" />
                                        <input type="hidden" name="hybridPaymentRequestId" value="@Model.HybridPaymentStatusResultModel.HybridPaymentRequestId" />
                                        <input type="hidden" name="hekmatGatewayTransactionId" value="@Model.HybridPaymentStatusResultModel.HekmatPaymentGatewayTransactionId" />
                                    }
                                    else
                                    {
                                        <input type="hidden" name="message" value="@Model.Message" />
                                        <input type="hidden" name="reservationNumber" value="@Model.ReservationNumber" />
                                        <input type="hidden" name="refrenceNumber" value="@Model.RefrenceNumber" />
                                        <input type="hidden" name="statusCode" value="@Model.StateCode" />
                                        <input type="hidden" name="amount" value="@Model.Amount" />
                                        <input type="hidden" name="paymentMethodType" value="@PaymentMethodTypesEnum.Hekmat" />
                                    }
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var intervalId;
        setTimeInterval(10);
        function setTimeInterval(expireTimeValue) {
            var minute = 0;
            var sec = 0;
            if (expireTimeValue >= 60) {
                minute = parseInt(expireTimeValue / 60);
                sec = expireTimeValue % 60;
            }
            else {
                sec = expireTimeValue;
            }

            intervalId = setInterval(function () {

                if (sec > 0) {
                    sec = sec - 1;
                }
                if (sec == 0 && minute > 0) {
                    minute = minute - 1;
                    sec = 59;
                }
                if (sec == 0 && minute == 0) {
                    returnToMerchantSite();

                }

                $('#remaining-time').html(minute + ":" + sec);

            }, 1000);

        }


        function returnToMerchantSite() {
            document.getElementById("btnReturnToMerchantSite").setAttribute("disabled", "");
            document.getElementById("completePaymentForm").submit();
            clearInterval(intervalId);

        }

    </script>
}






















